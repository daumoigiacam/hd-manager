{
  "expo": {
    "name": "HD Manager",
    "slug": "hd-manager",
    "version": "2026.8.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hdmanager",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hdmanager.app",
      "supportsTablet": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
