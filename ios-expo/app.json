          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "HD Manager can dung camera de chup anh so sach, hang hoa va bao cao giao hang.",
        "NSMicrophoneUsageDescription": "HD Manager can dung micro de ghi am len don va phieu xuat kho.",
        "NSPhotoLibraryUsageDescription": "HD Manager can truy cap thu vien anh de chon hinh anh bao cao.",
        "NSPhotoLibraryAddUsageDescription": "HD Manager can luu hinh anh hoac file chia se khi ban yeu cau.",
        "NSLocationWhenInUseUsageDescription": "HD Manager can dung vi tri de cham cong GPS va dinh vi khach hang.",
        "NSContactsUsageDescription": "HD Manager can truy cap danh ba khi ban muon lay thong tin khach hang tu dien thoai.",
        "NSLocalNetworkUsageDescription": "HD Manager can ket noi may chu noi bo tren cung WiFi khi test bang Expo hoac may tinh cong ty."
      }
    },
    "android": {
      "package": "com.hdmanager.iospreview",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS",
