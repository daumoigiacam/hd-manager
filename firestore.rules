rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasCompanyClaim() {
      return signedIn()
        && request.auth.token.companyId is string
        && request.auth.token.companyId.size() > 0;
    }

    function hasIdentitySession() {
      return hasCompanyClaim()
        && request.auth.token.identityId is string
        && request.auth.token.identityId.size() > 0
        && request.auth.token.accountType is string
        && request.auth.token.accountType in ['employee', 'customer'];
    }

    function isEmployeeIdentity() {
      return hasIdentitySession() && request.auth.token.accountType == 'employee';
    }

    function isCustomerIdentity() {
      return hasIdentitySession()
        && request.auth.token.accountType == 'customer'
        && request.auth.token.customerId is string
        && request.auth.token.customerId.size() > 0
        && request.auth.token.appUserId is string
        && request.auth.token.appUserId.size() > 0;
    }

    function belongsToSignedInCompany(collectionId, docId, data) {
      return hasIdentitySession()
        && (
          (collectionId == 'companies' && docId == request.auth.token.companyId)
          || (
            collectionId != 'companies'
            && data.companyId is string
            && data.companyId == request.auth.token.companyId
          )
        );
    }

    function employeePath(appId, employeeId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(employeeId);
    }

    function customerPath(appId, customerId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/customers/$(customerId);
    }

    function hasNonEmptyStringField(data, fieldName) {
      return fieldName in data
        && data[fieldName] is string
        && data[fieldName].size() > 0;
    }

    function hasCustomerMessagingAssignment(appId, customerId) {
      return exists(customerPath(appId, customerId))
        && get(customerPath(appId, customerId)).data.companyId == request.auth.token.companyId
        && (
          hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
          || hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'assignedEmployeeId')
          || hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'salesEmpId')
          || hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'managerEmpId')
          || hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'employeeId')
          || hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'responsibleEmployeeId')
        );
    }

    function messageMatchesCustomerAssignment(appId, customerId, employeeId) {
      return exists(customerPath(appId, customerId))
        && get(customerPath(appId, customerId)).data.companyId == request.auth.token.companyId
        && (
          (
            hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
            && get(customerPath(appId, customerId)).data.empId == employeeId
          )
          || (
            !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
            && hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'assignedEmployeeId')
            && get(customerPath(appId, customerId)).data.assignedEmployeeId == employeeId
          )
          || (
            !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'assignedEmployeeId')
            && hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'salesEmpId')
            && get(customerPath(appId, customerId)).data.salesEmpId == employeeId
          )
          || (
            !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'assignedEmployeeId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'salesEmpId')
            && hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'managerEmpId')
            && get(customerPath(appId, customerId)).data.managerEmpId == employeeId
          )
          || (
            !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'assignedEmployeeId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'salesEmpId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'managerEmpId')
            && hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'employeeId')
            && get(customerPath(appId, customerId)).data.employeeId == employeeId
          )
          || (
            !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'empId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'assignedEmployeeId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'salesEmpId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'managerEmpId')
            && !hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'employeeId')
            && hasNonEmptyStringField(get(customerPath(appId, customerId)).data, 'responsibleEmployeeId')
            && get(customerPath(appId, customerId)).data.responsibleEmployeeId == employeeId
          )
        );
    }

    function isMessagingManager(appId) {
      return isEmployeeIdentity()
        && 'role' in request.auth.token
        && request.auth.token.role in [
          'super_admin',
          'owner',
          'company_owner',
          'business_owner',
          'admin',
          'manager',
          'accounting',
          'accountant'
        ];
    }

    function hasValidCustomerMessageRouting(appId, data) {
      return 'customerId' in data
        && data.customerId is string
        && data.customerId.size() > 0
        && 'conversationId' in data
        && data.conversationId is string
        && data.conversationId == 'customer_' + data.customerId
        && 'assignmentState' in data
        && data.assignmentState is string
        && (
          (
            hasCustomerMessagingAssignment(appId, data.customerId)
            && data.assignmentState == 'assigned'
            && 'assignedEmployeeId' in data
            && data.assignedEmployeeId is string
            && data.assignedEmployeeId.size() > 0
            && messageMatchesCustomerAssignment(appId, data.customerId, data.assignedEmployeeId)
          )
          || (
            !hasCustomerMessagingAssignment(appId, data.customerId)
            && data.assignmentState == 'unclassified'
            && !('assignedEmployeeId' in data)
          )
        );
    }

    function customerOwnsDocument(collectionId, docId, data) {
      return isCustomerIdentity()
        && (
          (collectionId == 'customers' && docId == request.auth.token.customerId)
          || ('customerId' in data && data.customerId == request.auth.token.customerId)
          || ('customer_id' in data && data.customer_id == request.auth.token.customerId)
          || ('createdByCustomerId' in data && data.createdByCustomerId == request.auth.token.customerId)
          || ('senderCustomerId' in data && data.senderCustomerId == request.auth.token.customerId)
        );
    }

    function customerOwnsInboxDocument(data) {
      return isCustomerIdentity()
        && data.companyId is string
        && data.companyId == request.auth.token.companyId
        && data.customerId is string
        && data.customerId == request.auth.token.customerId;
    }

    function canCustomerReadNotification(data) {
      return customerOwnsInboxDocument(data)
        && data.recipientType is string
        && data.recipientType == 'customer';
    }

    function canCustomerReadMessage(data) {
      return customerOwnsInboxDocument(data)
        && data.conversationType is string
        && data.conversationType == 'customer_support';
    }

    function canCustomerCreateMessage(appId, data) {
      return canCustomerReadMessage(data)
        && data.senderCustomerId is string
        && data.senderCustomerId == request.auth.token.customerId
        && data.senderType is string
        && data.senderType == 'customer'
        && data.source is string
        && data.source == 'customer_portal'
        && data.type is string
        && data.type in ['customer_to_employee', 'loyalty_point_withdraw_request']
        && hasValidCustomerMessageRouting(appId, data);
    }

    function canCustomerMarkNotificationRead(oldData, newData) {
      return canCustomerReadNotification(oldData)
        && canCustomerReadNotification(newData)
        && newData.companyId == oldData.companyId
        && newData.readStatus == 'read'
        && newData.readByCustomerId == request.auth.token.customerId
        && newData.diff(oldData).affectedKeys().hasOnly([
          'readStatus',
          'readAt',
          'readByCustomerId',
          'updatedAt'
        ]);
    }

    function canCustomerMarkMessageRead(oldData, newData) {
      return canCustomerReadMessage(oldData)
        && canCustomerReadMessage(newData)
        && newData.companyId == oldData.companyId
        && newData.customerReadById == request.auth.token.customerId
        && newData.diff(oldData).affectedKeys().hasOnly([
          'customerReadAt',
          'customerReadById',
          'updatedAt'
        ]);
    }

    function canCustomerReadDocument(collectionId, docId, data) {
      return isCustomerIdentity()
        && !(collectionId in [
          'companies',
          'products',
          'reward_catalog',
          'promotions',
          'customer_accounts',
          'customer_payment_intents',
          'customer_payment_intent_lookup',
          'customer_payment_intent_transactions'
        ])
        && (
          (collectionId == 'notifications' && canCustomerReadNotification(data))
          || (collectionId == 'messages' && canCustomerReadMessage(data))
          || (
            collectionId != 'notifications'
            && collectionId != 'messages'
            && customerOwnsDocument(collectionId, docId, data)
          )
        );
    }

    function isServerManagedCustomerPaymentCollection(collectionId) {
      return collectionId in [
        'customer_payment_intents',
        'customer_payment_intent_lookup',
        'customer_payment_intent_transactions'
      ];
    }

    function isCustomerWritableCollection(collectionId) {
      return collectionId in [
        'customers',
        'bankAccounts',
        'customer_cart',
        'orderRequests',
        'order_requests'
      ];
    }

    function canCustomerCreateDocument(appId, collectionId, docId, data) {
      return (collectionId == 'messages' && canCustomerCreateMessage(appId, data))
        || (
          collectionId != 'messages'
          && collectionId != 'notifications'
          && isCustomerWritableCollection(collectionId)
          && customerOwnsDocument(collectionId, docId, data)
        );
    }

    function canCustomerUpdateDocument(collectionId, docId, oldData, newData) {
      return (collectionId == 'notifications' && canCustomerMarkNotificationRead(oldData, newData))
        || (collectionId == 'messages' && canCustomerMarkMessageRead(oldData, newData))
        || (
          collectionId != 'messages'
          && collectionId != 'notifications'
          && isCustomerWritableCollection(collectionId)
          && customerOwnsDocument(collectionId, docId, oldData)
          && customerOwnsDocument(collectionId, docId, newData)
          && newData.companyId == oldData.companyId
          && (
            collectionId != 'customers'
            || newData.diff(oldData).affectedKeys().hasOnly([
              'name',
              'customerHonorific',
              'phone',
              'avatarUrl',
              'avatar',
              'address',
              'location',
              'locationUrl',
              'locationInput',
              'locationLat',
              'locationLng',
              'mapLocation',
              'locationUpdatedAt',
              'locationSource',
              'birthday',
              'dateOfBirth',
              'email',
              'zaloGroupLink',
              'zaloLink',
              'updatedAt'
            ])
          )
        );
    }

    function canCustomerDeleteDocument(collectionId, docId, data) {
      return collectionId in ['customer_cart', 'orderRequests', 'order_requests']
        && customerOwnsDocument(collectionId, docId, data);
    }

    function canEmployeeReadCustomerSupportMessage(appId, data) {
      return isMessagingManager(appId)
        || (
          isEmployeeIdentity()
          && data.assignmentState == 'assigned'
          && data.assignedEmployeeId == request.auth.token.appUserId
        );
    }

    function canEmployeeReadMessage(appId, data) {
      return isEmployeeIdentity()
        && (
          !('conversationType' in data)
          || data.conversationType != 'customer_support'
          || canEmployeeReadCustomerSupportMessage(appId, data)
        );
    }

    function canEmployeeCreateMessage(appId, data) {
      return isEmployeeIdentity()
        && (
          !('conversationType' in data)
          || data.conversationType != 'customer_support'
          || (
            'senderType' in data
            && data.senderType is string
            && data.senderType == 'employee'
            && 'senderEmpId' in data
            && data.senderEmpId is string
            && data.senderEmpId == request.auth.token.appUserId
            && hasValidCustomerMessageRouting(appId, data)
            && (
              isMessagingManager(appId)
              || (
                data.assignmentState == 'assigned'
                && data.assignedEmployeeId == request.auth.token.appUserId
              )
            )
          )
        );
    }

    function canEmployeeUpdateMessage(appId, oldData, newData) {
      return isEmployeeIdentity()
        && (
          (
            (!('conversationType' in oldData) || oldData.conversationType != 'customer_support')
            && (!('conversationType' in newData) || newData.conversationType != 'customer_support')
          )
          || (isMessagingManager(appId) && hasValidCustomerMessageRouting(appId, newData))
        );
    }

    function canEmployeeDeleteMessage(appId, data) {
      return isEmployeeIdentity()
        && (
          !('conversationType' in data)
          || data.conversationType != 'customer_support'
          || isMessagingManager(appId)
        );
    }

    function canReadApplicationDocument(appId, collectionId, docId, data) {
      return (isEmployeeIdentity()
        && collectionId != 'customer_accounts'
        && (collectionId != 'messages' || canEmployeeReadMessage(appId, data)))
        || canCustomerReadDocument(collectionId, docId, data);
    }

    function payrollPeriodPath(appId, periodId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollPeriods/$(periodId);
    }

    function payrollSnapshotPath(appId, snapshotId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollSnapshots/$(snapshotId);
    }

    function payrollAdjustmentPath(appId, adjustmentId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollAdjustments/$(adjustmentId);
    }

    function payrollCarryoverPath(appId, carryoverId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollDebtCarryovers/$(carryoverId);
    }

    function payrollAutoLockPlanPath(appId, planId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollAutoLockPlans/$(planId);
    }

    function isPayrollManager(appId) {
      return isEmployeeIdentity()
        && (
          (
            'role' in request.auth.token
            && request.auth.token.role in [
              'super_admin',
              'owner',
              'company_owner',
              'business_owner',
              'accounting',
              'accountant',
              'admin'
            ]
          )
          || (
            'appUserId' in request.auth.token
            && request.auth.token.appUserId is string
            && exists(employeePath(appId, request.auth.token.appUserId))
            && get(employeePath(appId, request.auth.token.appUserId)).data.companyId == request.auth.token.companyId
            && get(employeePath(appId, request.auth.token.appUserId)).data.position in [
              'Chủ doanh nghiệp',
              'Kế toán & nhân sự'
            ]
          )
        );
    }

    function isLockedPayrollStatus(status) {
      return status in ['LOCKED', 'ADJUSTED', 'AUTO_LOCKED', 'CLOSED', 'locked', 'adjusted', 'auto_locked', 'closed'];
    }

    function isImmutablePayrollCollection(collectionId) {
      return collectionId in [
        'payrollSnapshots',
        'payrollAdjustments',
        'automaticEvaluations',
        'automaticEvaluationDetails',
        'employeeEvaluationSummaries',
        'evaluationRewards',
        'evaluationAuditLogs'
      ];
    }

    function isProtectedPayrollCollection(collectionId) {
      return collectionId in [
        'payrollPeriods',
        'payrollSnapshots',
        'payrollAdjustments',
        'payrollDebtCarryovers',
        'payrollAutoLockPlans',
        'payrollAutoLockPlanSnapshots',
        'evaluationPeriods',
        'automaticEvaluations',
        'automaticEvaluationDetails',
        'employeeEvaluationSummaries',
        'evaluationRewards',
        'evaluationAuditLogs'
      ];
    }

    function isImmutablePayrollAudit(collectionId, data) {
      return collectionId == 'activityLogs'
        && data.type in ['payroll_adjustment', 'payroll_period_lock', 'payroll_debt_rollover'];
    }

    function isProtectedPayrollDocument(collectionId, data) {
      return isProtectedPayrollCollection(collectionId) || isImmutablePayrollAudit(collectionId, data);
    }

    function canReadPayrollDocument(collectionId, data) {
      return !isProtectedPayrollDocument(collectionId, data)
        || (
          hasCompanyClaim()
          && data.companyId is string
          && data.companyId == request.auth.token.companyId
        );
    }

    function hasCompletePayrollSnapshot(data) {
      return data.schemaVersion is int
        && data.schemaVersion >= 2
        && data.companyId is string
        && data.periodId is string
        && data.monthKey is string
        && data.employeeId is string
        && data.lockedAt is string
        && data.formulaVersion is string
        && data.formulaVersion.size() > 0
        && data.policyVersion is string
        && data.policyVersion.size() > 0
        && data.employee is map
        && data.salaryDetails is map
        && data.salaryDetails.netSalary is number
        && data.salaryDetails.endingDebt is number
        && data.policySnapshot is map
        && data.policySnapshot.values is map
        && data.policySnapshot.values.size() > 0
        && data.policySnapshot.version == data.policyVersion
        && data.policySnapshot.formulaVersion == data.formulaVersion
        && data.calculationSnapshot is map
        && data.calculationSnapshot.inputs is map
        && data.calculationSnapshot.additions is map
        && data.calculationSnapshot.deductions is map
        && data.calculationSnapshot.results is map
        && data.calculationSnapshot.results.grossSalary is number
        && data.calculationSnapshot.results.netSalary is number
        && data.calculationSnapshot.results.endingDebt is number;
    }

    function isValidLockedPayrollPeriodCreate(appId, docId) {
      return isPayrollManager(appId)
        && request.resource.data.id == docId
        && request.resource.data.status == 'LOCKED'
        && request.resource.data.companyId == request.auth.token.companyId
        && request.resource.data.monthKey is string
        && request.resource.data.lockedAt is string
        && request.resource.data.snapshotIds is list
        && request.resource.data.snapshotIds.size() > 0
        && request.resource.data.employeeCount == request.resource.data.snapshotIds.size()
        && request.resource.data.debtCarryoverIds is list;
    }

    function isValidPayrollSnapshotCreate(appId, docId) {
      let data = request.resource.data;
      let period = getAfter(payrollPeriodPath(appId, data.periodId)).data;
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && hasCompletePayrollSnapshot(data)
        && existsAfter(payrollPeriodPath(appId, data.periodId))
        && period.companyId == data.companyId
        && period.monthKey == data.monthKey
        && isLockedPayrollStatus(period.status)
        && period.snapshotIds is list
        && docId in period.snapshotIds;
    }

    function isValidPayrollCarryoverCreate(appId, docId) {
      let data = request.resource.data;
      let period = getAfter(payrollPeriodPath(appId, data.sourcePeriodId)).data;
      let snapshot = getAfter(payrollSnapshotPath(appId, data.sourceSnapshotId)).data;
      let adjustmentId = 'adjustedByPayrollAdjustmentId' in data
        ? data.adjustedByPayrollAdjustmentId
        : '';
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.employeeId is string
        && data.amount is number
        && data.amount >= 0
        && existsAfter(payrollPeriodPath(appId, data.sourcePeriodId))
        && existsAfter(payrollSnapshotPath(appId, data.sourceSnapshotId))
        && period.companyId == data.companyId
        && isLockedPayrollStatus(period.status)
        && period.debtCarryoverIds is list
        && docId in period.debtCarryoverIds
        && snapshot.companyId == data.companyId
        && snapshot.periodId == data.sourcePeriodId
        && snapshot.employeeId == data.employeeId
        && (
          (
            adjustmentId == ''
            && data.amount > 0
            && data.amount == snapshot.salaryDetails.endingDebt
          )
          || (
            adjustmentId is string
            && adjustmentId.size() > 0
            && existsAfter(payrollAdjustmentPath(appId, adjustmentId))
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.companyId == data.companyId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.periodId == data.sourcePeriodId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.snapshotId == data.sourceSnapshotId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.employeeId == data.employeeId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.afterSalaryDetails.endingDebt == data.amount
            && period.lastAdjustmentId == adjustmentId
          )
        );
    }

    function isValidPayrollAdjustmentCreate(appId, docId) {
      let data = request.resource.data;
      let period = getAfter(payrollPeriodPath(appId, data.periodId)).data;
      let priorPeriod = get(payrollPeriodPath(appId, data.periodId)).data;
      let snapshot = get(payrollSnapshotPath(appId, data.snapshotId)).data;
      let previousAdjustmentId = data.previousAdjustmentId;
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.status == 'ADJUSTED'
        && data.reason is string
        && data.reason.size() > 0
        && data.beforeSalaryDetails is map
        && data.afterSalaryDetails is map
        && data.beforeSalaryDetails.netSalary is number
        && data.beforeSalaryDetails.endingDebt is number
        && data.afterSalaryDetails.netSalary is number
        && data.afterSalaryDetails.netSalary >= 0
        && data.afterSalaryDetails.endingDebt is number
        && data.afterSalaryDetails.endingDebt >= 0
        && data.differences is map
        && data.differences.netSalary == data.afterSalaryDetails.netSalary - data.beforeSalaryDetails.netSalary
        && data.differences.endingDebt == data.afterSalaryDetails.endingDebt - data.beforeSalaryDetails.endingDebt
        && data.sequence is int
        && data.sequence >= 1
        && previousAdjustmentId is string
        && exists(payrollSnapshotPath(appId, data.snapshotId))
        && existsAfter(payrollPeriodPath(appId, data.periodId))
        && snapshot.companyId == data.companyId
        && snapshot.periodId == data.periodId
        && snapshot.employeeId == data.employeeId
        && snapshot.monthKey == data.monthKey
        && period.status == 'ADJUSTED'
        && period.lastAdjustmentId == docId
        && period.latestAdjustmentBySnapshot is map
        && period.latestAdjustmentBySnapshot[data.snapshotId] == docId
        && (
          (
            previousAdjustmentId == ''
            && data.sequence == 1
            && data.beforeSalaryDetails == snapshot.salaryDetails
            && (
              !('latestAdjustmentBySnapshot' in priorPeriod)
              || !(data.snapshotId in priorPeriod.latestAdjustmentBySnapshot)
            )
          )
          || (
            previousAdjustmentId.size() > 0
            && exists(payrollAdjustmentPath(appId, previousAdjustmentId))
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.companyId == data.companyId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.periodId == data.periodId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.snapshotId == data.snapshotId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.employeeId == data.employeeId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.afterSalaryDetails == data.beforeSalaryDetails
            && data.sequence == get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.sequence + 1
            && priorPeriod.latestAdjustmentBySnapshot[data.snapshotId] == previousAdjustmentId
          )
        );
    }

    function hasValidPayrollAutoLockPlanPayload(docId, data) {
      return data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.status in ['OPEN', 'READY']
        && data.rulesVersion == 'PAYROLL_FREEZE_RULES_V2'
        && data.periodId is string
        && data.monthKey is string
        && data.autoLockAt is string
        && data.closingSchedule is map
        && data.closingSchedule.mode == 'MONTH_END'
        && data.closingSchedule.timeZone == 'Asia/Ho_Chi_Minh'
        && data.closingSchedule.time == '23:59:59'
        && data.stagedSnapshotIds is list
        && data.stagedSnapshotIds.size() > 0
        && data.expectedEmployeeIds is list
        && data.expectedEmployeeIds.size() == data.stagedSnapshotIds.size()
        && data.snapshotCount == data.stagedSnapshotIds.size()
        && (
          data.status == 'READY'
          || (
            data.period is map
            && data.period.status == 'OPEN'
            && !('lockedAt' in data.period)
          )
        );
    }

    function isValidPayrollAutoLockPlanCreate(appId, docId) {
      return isPayrollManager(appId)
        && hasValidPayrollAutoLockPlanPayload(docId, request.resource.data);
    }

    function isValidPayrollAutoLockPlanUpdate(appId, docId) {
      return isPayrollManager(appId)
        && resource.data.status in ['OPEN', 'READY']
        && resource.data.rulesVersion == 'PAYROLL_FREEZE_RULES_V2'
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.monthKey == resource.data.monthKey
        && hasValidPayrollAutoLockPlanPayload(docId, request.resource.data);
    }

    function isValidPayrollAutoLockSnapshotWrite(appId, docId) {
      let data = request.resource.data;
      let plan = getAfter(payrollAutoLockPlanPath(appId, data.planId)).data;
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.snapshotId is string
        && data.employeeId is string
        && data.periodId is string
        && data.monthKey is string
        && existsAfter(payrollAutoLockPlanPath(appId, data.planId))
        && plan.companyId == data.companyId
        && plan.periodId == data.periodId
        && plan.monthKey == data.monthKey
        && plan.status in ['OPEN', 'READY']
        && plan.rulesVersion == 'PAYROLL_FREEZE_RULES_V2'
        && plan.stagedSnapshotIds is list
        && docId in plan.stagedSnapshotIds
        && (
          (
            plan.status == 'OPEN'
            && data.status == 'STAGED'
            && !('lockedAt' in data)
            && !('lockedByEmployeeId' in data)
          )
          || (
            plan.status == 'READY'
            && hasCompletePayrollSnapshot(data)
          )
        );
    }

    function isValidPayrollAuditCreate(appId) {
      let data = request.resource.data;
      return isPayrollManager(appId)
        && (
          (
            data.type == 'payroll_period_lock'
            && data.periodId is string
            && existsAfter(payrollPeriodPath(appId, data.periodId))
            && isLockedPayrollStatus(getAfter(payrollPeriodPath(appId, data.periodId)).data.status)
          )
          || (
            data.type == 'payroll_debt_rollover'
            && data.carryoverId is string
            && existsAfter(payrollCarryoverPath(appId, data.carryoverId))
          )
          || (
            data.type == 'payroll_adjustment'
            && data.adjustmentId is string
            && existsAfter(payrollAdjustmentPath(appId, data.adjustmentId))
          )
        );
    }

    function isAllowedLockedPayrollPeriodAdjustment(appId, docId) {
      let adjustmentId = request.resource.data.lastAdjustmentId;
      let adjustment = getAfter(payrollAdjustmentPath(appId, adjustmentId)).data;
      let priorAdjustmentCount = 'adjustmentCount' in resource.data
        ? resource.data.adjustmentCount
        : 0;
      return isPayrollManager(appId)
        && isLockedPayrollStatus(resource.data.status)
        && request.resource.data.status == 'ADJUSTED'
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.monthKey == resource.data.monthKey
        && request.resource.data.lockedAt == resource.data.lockedAt
        && request.resource.data.snapshotIds == resource.data.snapshotIds
        && adjustmentId is string
        && adjustmentId.size() > 0
        && existsAfter(payrollAdjustmentPath(appId, adjustmentId))
        && adjustment.companyId == resource.data.companyId
        && adjustment.periodId == docId
        && request.resource.data.latestAdjustmentBySnapshot is map
        && request.resource.data.latestAdjustmentBySnapshot[adjustment.snapshotId] == adjustmentId
        && request.resource.data.adjustmentCount == priorAdjustmentCount + 1
        && request.resource.data.debtTransferCount == request.resource.data.debtCarryoverIds.size()
        && request.resource.data.totals.totalSalary == resource.data.totals.totalSalary + adjustment.differences.netSalary
        && request.resource.data.totals.totalEndingDebt == resource.data.totals.totalEndingDebt + adjustment.differences.endingDebt
        && request.resource.data.totalEndingDebt == request.resource.data.totals.totalEndingDebt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'totals',
          'totalEndingDebt',
          'debtCarryoverIds',
          'debtTransferCount',
          'adjustmentCount',
          'latestAdjustmentBySnapshot',
          'lastAdjustmentId',
          'lastAdjustedAt',
          'lastAdjustedByEmployeeId',
          'updatedAt'
        ]);
    }

    function isAllowedPayrollDebtCarryoverAdjustment(appId, docId) {
      let adjustmentId = request.resource.data.adjustedByPayrollAdjustmentId;
      let adjustment = getAfter(payrollAdjustmentPath(appId, adjustmentId)).data;
      let period = getAfter(payrollPeriodPath(appId, resource.data.sourcePeriodId)).data;
      return isPayrollManager(appId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.sourcePeriodId == resource.data.sourcePeriodId
        && request.resource.data.sourceSnapshotId == resource.data.sourceSnapshotId
        && request.resource.data.sourceMonthKey == resource.data.sourceMonthKey
        && request.resource.data.targetMonthKey == resource.data.targetMonthKey
        && adjustmentId is string
        && adjustmentId.size() > 0
        && existsAfter(payrollAdjustmentPath(appId, adjustmentId))
        && existsAfter(payrollPeriodPath(appId, resource.data.sourcePeriodId))
        && adjustment.companyId == resource.data.companyId
        && adjustment.periodId == resource.data.sourcePeriodId
        && adjustment.snapshotId == resource.data.sourceSnapshotId
        && adjustment.employeeId == resource.data.employeeId
        && request.resource.data.amount == adjustment.afterSalaryDetails.endingDebt
        && (
          (
            request.resource.data.amount == 0
            && request.resource.data.status == 'cleared_by_adjustment'
            && request.resource.data.isArchived == true
          )
          || (
            request.resource.data.amount > 0
            && request.resource.data.status == 'adjusted_carry_over'
            && request.resource.data.isArchived == false
          )
        )
        && period.lastAdjustmentId == adjustmentId
        && period.debtCarryoverIds is list
        && docId in period.debtCarryoverIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount',
          'status',
          'isArchived',
          'adjustedByPayrollAdjustmentId',
          'updatedAt'
        ]);
    }

    match /artifacts/{appId}/public/data/{collectionId}/{docId} {
      allow get: if hasIdentitySession()
        && (
          resource == null
            ? (!isProtectedPayrollCollection(collectionId) || isPayrollManager(appId))
            : (
              belongsToSignedInCompany(collectionId, docId, resource.data)
              && canReadApplicationDocument(appId, collectionId, docId, resource.data)
              && canReadPayrollDocument(collectionId, resource.data)
            )
        );

      allow list: if hasIdentitySession()
        && belongsToSignedInCompany(collectionId, docId, resource.data)
        && canReadApplicationDocument(appId, collectionId, docId, resource.data)
        && canReadPayrollDocument(collectionId, resource.data);

      allow create: if hasIdentitySession()
        && !isServerManagedCustomerPaymentCollection(collectionId)
        && belongsToSignedInCompany(collectionId, docId, request.resource.data)
        && (
          (
            isEmployeeIdentity()
            && collectionId != 'customer_accounts'
            && (collectionId != 'messages' || canEmployeeCreateMessage(appId, request.resource.data))
          )
          || canCustomerCreateDocument(appId, collectionId, docId, request.resource.data)
        )
        && (
          (collectionId == 'payrollPeriods' && isValidLockedPayrollPeriodCreate(appId, docId))
          || (collectionId == 'payrollSnapshots' && isValidPayrollSnapshotCreate(appId, docId))
          || (collectionId == 'payrollAdjustments' && isValidPayrollAdjustmentCreate(appId, docId))
          || (collectionId == 'payrollDebtCarryovers' && isValidPayrollCarryoverCreate(appId, docId))
          || (collectionId == 'payrollAutoLockPlans' && isValidPayrollAutoLockPlanCreate(appId, docId))
          || (collectionId == 'payrollAutoLockPlanSnapshots' && isValidPayrollAutoLockSnapshotWrite(appId, docId))
          || (collectionId == 'activityLogs' && isImmutablePayrollAudit(collectionId, request.resource.data) && isValidPayrollAuditCreate(appId))
          || (!isProtectedPayrollCollection(collectionId) && !isImmutablePayrollAudit(collectionId, request.resource.data))
        );

      allow update: if hasIdentitySession()
        && !isServerManagedCustomerPaymentCollection(collectionId)
        && belongsToSignedInCompany(collectionId, docId, resource.data)
        && belongsToSignedInCompany(collectionId, docId, request.resource.data)
        && (
          (
            isEmployeeIdentity()
            && collectionId != 'customer_accounts'
            && (collectionId != 'messages' || canEmployeeUpdateMessage(appId, resource.data, request.resource.data))
          )
          || canCustomerUpdateDocument(collectionId, docId, resource.data, request.resource.data)
        )
        && !isImmutablePayrollCollection(collectionId)
        && !isImmutablePayrollAudit(collectionId, resource.data)
        && (
          !isProtectedPayrollCollection(collectionId)
          || (
            collectionId == 'payrollPeriods'
            && isLockedPayrollStatus(resource.data.status)
            && isAllowedLockedPayrollPeriodAdjustment(appId, docId)
          )
          || (
            collectionId == 'payrollDebtCarryovers'
            && isAllowedPayrollDebtCarryoverAdjustment(appId, docId)
          )
          || (
            collectionId == 'payrollAutoLockPlans'
            && isValidPayrollAutoLockPlanUpdate(appId, docId)
          )
          || (
            collectionId == 'payrollAutoLockPlanSnapshots'
            && isValidPayrollAutoLockSnapshotWrite(appId, docId)
          )
        );

      allow delete: if hasIdentitySession()
        && !isServerManagedCustomerPaymentCollection(collectionId)
        && belongsToSignedInCompany(collectionId, docId, resource.data)
        && (
          (
            isEmployeeIdentity()
            && collectionId != 'customer_accounts'
            && (collectionId != 'messages' || canEmployeeDeleteMessage(appId, resource.data))
          )
          || canCustomerDeleteDocument(collectionId, docId, resource.data)
        )
        && !isImmutablePayrollCollection(collectionId)
        && !isImmutablePayrollAudit(collectionId, resource.data)
        && (
          !isProtectedPayrollCollection(collectionId)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
