rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasCompanyClaim() {
      return signedIn()
        && request.auth.token.companyId is string
        && request.auth.token.companyId.size() > 0;
    }

    function hasIdentitySession() {
      return hasCompanyClaim()
        && request.auth.token.identityId is string
        && request.auth.token.identityId.size() > 0
        && request.auth.token.accountType is string
        && request.auth.token.accountType in ['employee', 'customer'];
    }

    function isEmployeeIdentity() {
      return hasIdentitySession() && request.auth.token.accountType == 'employee';
    }

    function canManageCompanyWifi() {
      return isEmployeeIdentity() && request.auth.token.role in ['super_admin', 'admin', 'owner', 'company_owner', 'business_owner'];
    }

    function companyWifiKeys() {
      return ['attendanceWifi', 'attendanceWifiEnabled', 'attendanceWifiSsid', 'attendanceWifiBssid', 'attendanceWifiUpdatedAt', 'defaultAttendanceWifiSsid', 'defaultAttendanceWifiBssid', 'attendanceBiometricRequired'];
    }

    function customerProductKeys() {
      return ['priceOverrides', 'customPrices', 'customerProductIds', 'branches', 'customerBranches',
        'productConfigVersion', 'productConfigUpdatedBy'];
    }

    function customerConfigActionEnabled(appId, customer) {
      let employee = get(dispatchEmployeePath(appId)).data;
      let company = get(dispatchCompanyPath(appId)).data;
      let roleKey = dispatchRoleKey(employee);
      let individual = request.auth.token.appUserId in company.get('employeeRolePermissions', {});
      let permissions = individual
        ? company.get('employeeRolePermissions', {}).get(request.auth.token.appUserId, {})
        : company.get('rolePermissions', {}).get(roleKey, {});
      let actions = individual
        ? company.get('employeeRolePermissionActions', {}).get(request.auth.token.appUserId, {}).get('customers', {})
        : company.get('rolePermissionActions', {}).get(roleKey, {}).get('customers', {});
      return employee.companyId == request.auth.token.companyId
        && employee.get('isArchived', false) != true
        && permissions.get('customers', roleKey in ['accounting', 'sales']) == true
        && actions.get('fixed_products', true) == true
        && actions.get('fixed_product_size_attribute', true) == true
        && actions.get('customer_price_overrides', true) == true
        && (actions.get('view_all_customers', true) == true
          || ((actions.get('view_customers', true) == true || actions.get('view_assigned_customers', true) == true)
            && customer.get('empId', '') == request.auth.token.appUserId));
    }

    function canManageCustomerProductConfig(appId, customer) {
      return isEmployeeIdentity() && (
        request.auth.token.role in ['super_admin', 'admin', 'owner', 'company_owner', 'business_owner']
        || (exists(dispatchEmployeePath(appId)) && customerConfigActionEnabled(appId, customer))
      );
    }

    function companyPermissionKeys() {
      return ['rolePermissions', 'rolePermissionActions', 'employeeRolePermissions', 'employeeRolePermissionActions'];
    }

    function companyEmployeeReviewKeys() {
      return ['employeeReviewsEnabled', 'employeeReviewsUpdatedByEmpId', 'employeeReviewsUpdatedAt'];
    }

    function employeeCommissionPolicyKeys() {
      return ['commissionTiers','commissionPolicy','commissionPolicyDraft','commissionRate','commissionBaseMode','targetRevenue',
        'payrollPolicies','salaryPolicyHistory','salaryPolicyVersion','salaryPolicyEffectiveFrom'];
    }

    function employeeCommissionRoleActionEnabled(appId, roleKey) {
      let company = get(dispatchCompanyPath(appId)).data;
      let overridden = request.auth.token.appUserId in company.get('employeeRolePermissions', {});
      let permissions = overridden
        ? company.get('employeeRolePermissions', {}).get(request.auth.token.appUserId, {})
        : company.get('rolePermissions', {}).get(roleKey, {});
      let actions = overridden
        ? company.get('employeeRolePermissionActions', {}).get(request.auth.token.appUserId, {})
        : company.get('rolePermissionActions', {}).get(roleKey, {});
      return actions.get('employees', {}).get('edit_employee_salary_policy', permissions.get('employees', roleKey == 'accounting')) == true;
    }

    function employeeCommissionActionEnabled(appId) {
      let employee = get(dispatchEmployeePath(appId)).data;
      let roleKey = dispatchRoleKey(employee);
      return employee.companyId == request.auth.token.companyId
        && employee.get('isArchived', false) != true
        && (roleKey == 'owner' ? exists(dispatchCompanyPath(appId)) : employeeCommissionRoleActionEnabled(appId,roleKey));
    }

    function canManageEmployeeCommissionPolicy(appId) {
      // Called only by the employee branch after hasIdentitySession and tenant checks.
      return request.auth.token.role in ['super_admin','admin']
        || employeeCommissionActionEnabled(appId);
    }

    function validCommissionTierAt(tiers, index, baseRate) {
      let tier = tiers[index];
      let threshold = tier.minExcessRevenue;
      let rate = tier.rate;
      let previousThreshold = index == 0 ? 0 : tiers[index-1].minExcessRevenue;
      let previousRate = index == 0 ? baseRate : tiers[index-1].rate;
      // Accessing both fields rejects missing keys; size rejects extra keys.
      return tier is map && tier.keys().size() == 2
        && threshold is int && threshold > previousThreshold
        && threshold <= 9007199254740991
        && rate is number && rate >= previousRate && rate <= 1;
    }

    function validEmployeeCommissionTiers(data) {
      let tiers = data.get('commissionTiers', []);
      let baseRate = data.get('commissionRate', 0);
      return tiers is list && tiers.size() <= 5
        && (tiers.size() == 0 || (baseRate is number && baseRate >= 0 && baseRate <= 1
          && validCommissionTierAt(tiers,0,baseRate)
          && (tiers.size() <= 1 || validCommissionTierAt(tiers,1,baseRate))
          && (tiers.size() <= 2 || validCommissionTierAt(tiers,2,baseRate))
          && (tiers.size() <= 3 || validCommissionTierAt(tiers,3,baseRate))
          && (tiers.size() <= 4 || validCommissionTierAt(tiers,4,baseRate))));
    }

    function validCommissionRange(tier, start, last) {
      let rate = tier.rate;
      let end = tier.to;
      let bonus = tier.fixedBonus;
      // One bounded conjunction avoids a deep boolean expression tree for
      // every range. Each entry must be true; malformed fields still deny.
      return [tier.from == start, tier.enabled is bool,
        (last ? end == null : end is int && end > start && end <= 9007199254740991),
        rate >= 0, rate <= 1, bonus is int, bonus >= 0, bonus <= 9007199254740991].hasOnly([true]);
    }

    function validCommissionPolicy(policy, draft) {
      let tiers = policy == null ? [] : policy.tiers;
      let count = tiers.size();
      return policy == null || (policy.schemaVersion == 2 && policy.cycle == 'months'
        && policy.policyId is string && policy.policyId.size() > 0
        && policy.method in ['fixed','above_kpi','progressive','retrospective']
        && policy.revenueBasis in ['recognized_net','collected']
        && (draft ? policy.status == 'draft' : policy.status in ['active','paused'])
        && policy.targetRevenue is int && policy.targetRevenue >= 0 && policy.targetRevenue <= 9007199254740991
        && policy.rate is number && policy.rate >= 0 && policy.rate <= 1
        && policy.effectiveFrom is string && policy.effectiveFrom.matches('^[0-9]{4}-(0[1-9]|1[0-2])-01$')
        && policy.effectiveTo is string && (policy.effectiveTo == '' || policy.effectiveTo >= policy.effectiveFrom)
        && tiers is list && count <= 5
        && (policy.method in ['fixed','above_kpi'] ? count == 0 : count > 0
          && validCommissionRange(tiers[0], 0, count == 1)
          && (count < 2 || validCommissionRange(tiers[1], tiers[0].to, count == 2))
          && (count < 3 || validCommissionRange(tiers[2], tiers[1].to, count == 3))
          && (count < 4 || validCommissionRange(tiers[3], tiers[2].to, count == 4))
          && (count < 5 || validCommissionRange(tiers[4], tiers[3].to, true))));
    }

    // A bounded employee-only branch avoids evaluating unrelated payroll,
    // customer, warehouse and messaging rules for each salary-policy write.
    function canChangeEmployeeCompanyAuthority(appId, oldData, newData, creating, changed) {
      return !changed.hasAny(['role', 'position', 'isOwner', 'isCompanyOwner'])
        || ((!creating && dispatchRoleKey(oldData) != 'owner') && dispatchRoleKey(newData) != 'owner')
        || (creating && dispatchRoleKey(newData) != 'owner')
        || canManageCompanyPermissions(appId);
    }

    function canWriteEmployeeDocument(appId, oldData, newData, creating) {
      let changed = creating ? newData.keys() : newData.diff(oldData).affectedKeys();
      return request.auth.token.accountType != 'employee' ? false
        : newData.companyId != request.auth.token.companyId ? false
        : (!creating && oldData.companyId != request.auth.token.companyId) ? false
        : !canChangeEmployeeCompanyAuthority(appId, oldData, newData, creating, changed) ? false
        : ((creating || changed.hasAny(employeeAttendanceSecurityKeys())) && !isPayrollManager(appId)) ? false
        : !changed.hasAny(employeeCommissionPolicyKeys()) ? true
        : !canManageEmployeeCommissionPolicy(appId) ? false
        : (changed.hasAny(['commissionTiers','commissionRate']) && !validEmployeeCommissionTiers(newData)) ? false
        : (changed.hasAny(['commissionPolicy']) && !validCommissionPolicy(newData.get('commissionPolicy', null), false)) ? false
        : !changed.hasAny(['commissionPolicyDraft']) || validCommissionPolicy(newData.get('commissionPolicyDraft', null), true);
    }

    function employeeReviewSettingsActionEnabled(appId) {
      let employee = get(dispatchEmployeePath(appId)).data;
      let company = get(dispatchCompanyPath(appId)).data;
      let roleKey = dispatchRoleKey(employee);
      let overridden = request.auth.token.appUserId in company.get('employeeRolePermissions', {});
      let actions = overridden
        ? company.get('employeeRolePermissionActions', {}).get(request.auth.token.appUserId, {})
        : company.get('rolePermissionActions', {}).get(roleKey, {});
      return employee.companyId == request.auth.token.companyId
        && employee.get('isArchived', false) != true
        && actions.get('settings', {}).get('manage_employee_review_settings', false) == true;
    }

    function canChangeCompanyEmployeeReviews(appId) {
      return isEmployeeIdentity()
        && (canManageCompanyPermissions(appId)
          || (exists(dispatchEmployeePath(appId)) && employeeReviewSettingsActionEnabled(appId)))
        && request.resource.data.get('employeeReviewsEnabled', true) is bool
        && request.resource.data.get('employeeReviewsUpdatedByEmpId', '') == request.auth.token.appUserId
        && request.resource.data.get('employeeReviewsUpdatedAt', null) == request.time;
    }

    function canWriteCompanyEmployeeReviewSettings(appId, companyId) {
      // Bounded branch: this small switch must not evaluate unrelated payroll,
      // warehouse or finance write policies when a grant is denied/revoked.
      return companyId == request.auth.token.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(companyEmployeeReviewKeys())
        && canChangeCompanyEmployeeReviews(appId);
    }

    // History stays readable for payroll and audit. Only review mutations stop.
    function employeeReviewWritesEnabled(appId, collectionId) {
      return collectionId != 'employeeReviews'
        || (exists(dispatchCompanyPath(appId))
          && get(dispatchCompanyPath(appId)).data.get('employeeReviewsEnabled', true) != false);
    }

    function dispatchEmployeePath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(request.auth.token.appUserId);
    }

    function dispatchCompanyPath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/companies/$(request.auth.token.companyId);
    }

    function dispatchRoleKey(employee) {
      let position = employee.get('position', '');
      return position == 'Chủ doanh nghiệp'
        || employee.get('role', '') in ['super_admin', 'owner', 'company_owner', 'business_owner', 'owneraccount', 'accountowner']
        || employee.get('isOwner', false) == true
        || employee.get('isCompanyOwner', false) == true ? 'owner'
        : position == 'Kế toán & nhân sự' ? 'accounting'
        : position == 'Tài xế' ? 'driver'
        : position == 'Kinh doanh' || position == 'Cộng tác viên kinh doanh' ? 'sales'
        : position == 'Xuất kho' ? 'warehouse'
        : 'production';
    }

    function canManageCompanyPermissions(appId) {
      return isEmployeeIdentity()
        && (
          request.auth.token.role in ['super_admin', 'admin']
          || (
            exists(dispatchEmployeePath(appId))
            && get(dispatchEmployeePath(appId)).data.companyId == request.auth.token.companyId
            && dispatchRoleKey(get(dispatchEmployeePath(appId)).data) == 'owner'
          )
        );
    }

    // Company writes have a bounded policy of their own. Reads retain the
    // existing tenant/query contract; server-owned identity/billing fields are
    // deliberately absent from this client mutation catalog.
    function companyMutationKeys() {
      return ['id','companyId','updatedAt','name','displayName','companyPhone','companyAddress','logoUrl','logo',
        'bankId','bankName','bankAccountName','bankAccountNumber','companyBankAccounts','primaryCompanyBankAccountId',
        'sepayVirtualAccountNumber','sepayVaAccountNumber','sepayVaNumber','sepayReceivingAccountNumber',
        'bankVirtualAccountNumber','virtualBankAccountNumber','vaAccountNumber','virtualAccountNumber','sepayUseVirtualAccount','autoReconcileByOrderCode',
        'invoiceQrTemplate','invoiceTemplateId','customerLoyaltyEnabled','loyaltyEarnMode','loyaltyRevenuePercent',
        'loyaltyEarnAmountPerPoint','loyaltyRedeemValuePerPoint','loyaltyEligibilityConditions',
        'customerCareReminderEnabled','customerCareInactiveDays','customerCareRules','warehouseOrderAutoCancelDays','floatingQuickActionEnabled',
        'warehouseStockResetAt','warehouseStockVisibilitySettings','warehouseQuantityUnits','warehouseQtyUnits','productGroups',
        'employeeDepartments','companyDepartments','salaryAdvancePercent','salaryAdvancePercentByDepartment','employeeReviewCriteriaLabels',
        'dailyInventorySnapshots','processingInventorySnapshots','rolePermissions','rolePermissionActions','employeeRolePermissions','employeeRolePermissionActions',
        'attendanceWifi','attendanceWifiEnabled','attendanceWifiSsid','attendanceWifiBssid','attendanceWifiUpdatedAt',
        'defaultAttendanceWifiSsid','defaultAttendanceWifiBssid','attendanceBiometricRequired',
        'employeeReviewsEnabled','employeeReviewsUpdatedByEmpId','employeeReviewsUpdatedAt',
        'zaloDispatcherEnabled','zaloDispatcherDisabled','zaloDispatcherMachineId','zaloDispatcherMachineName','zaloDispatcherHeartbeatAt',
        'zaloDispatcherWakeAt','zaloDispatcherDelayMinSec','zaloDispatcherDelayMaxSec','zaloDispatcherSendInvoicesEnabled',
        'zaloDispatcherSendCampaignsEnabled','zaloDispatcherPaused','zaloDispatcherMaxPerHour','zaloInboxBridgeEnabled',
        'zaloInboxBridgeMachineId','zaloInboxBridgeMachineName','zaloInboxBridgeHeartbeatAt','zaloInboxBridgeScanIntervalSec',
        'zaloInboxBridgeClipboardEnabled','zaloInboxBridgeAutoProcessEnabled','enableAiAutoReply','aiAutoReplyDryRun',
        'aiAutoReplyStartTime','aiAutoReplyEndTime','aiAutoReplyMaxPerGroupPerHour','zaloSchedulerMode','zaloSchedulerDailyTime',
        'zaloSchedulerDelayMinutes','zaloSchedulerEditHoldMinutes'];
    }

    function companyMutationContext(appId) {
      let employee = get(dispatchEmployeePath(appId)).data;
      let company = exists(dispatchCompanyPath(appId)) ? get(dispatchCompanyPath(appId)).data : {};
      let roleKey = dispatchRoleKey(employee);
      let individual = request.auth.token.appUserId in company.get('employeeRolePermissions', {});
      return {'roleKey':roleKey,
        'valid':employee.companyId == request.auth.token.companyId && employee.get('isArchived', false) != true,
        'modules':individual ? company.get('employeeRolePermissions', {}).get(request.auth.token.appUserId, {}) : company.get('rolePermissions', {}).get(roleKey, {}),
        'actions':individual ? company.get('employeeRolePermissionActions', {}).get(request.auth.token.appUserId, {}) : company.get('rolePermissionActions', {}).get(roleKey, {})};
    }

    function companyDefaultModule(roleKey, module) {
      return roleKey == 'owner' || roleKey == 'accounting'
        || (module == 'warehouse_import' && roleKey == 'warehouse')
        || (module in ['payroll','employee_reviews'])
        || (module == 'orders' && roleKey == 'sales');
    }

    function companyDefaultAction(roleKey, module, action) {
      // Match App's current DEFAULT_ROLE_PERMISSION_ACTIONS, including the
      // explicit-grant overrides applied after buildPermissionActionSet.
      return !(module == 'employee_reviews' && action == 'manage_employee_review_criteria')
        && !(module == 'payroll' && action == 'configure_salary_advance_limit' && roleKey != 'accounting')
        && !(module == 'settings' && action == 'manage_employee_review_settings')
        && module != 'role_permissions' && companyDefaultModule(roleKey, module);
    }

    function companyAction(context, module, action) {
      let explicit = context.actions.get(module, {}).get(action, null);
      return context.valid && (context.roleKey == 'owner'
        || (explicit != null ? explicit == true
          : context.modules.get(module, companyDefaultModule(context.roleKey, module)) == true && companyDefaultAction(context.roleKey, module, action)));
    }

    function companyResetAction(context) {
      return companyAction(context,'settings','reset_company_data') || companyAction(context,'settings','reset_selected_data_scopes');
    }

    function companyBankQrAllowed(context, oldData, newData) {
      let legacy = {'id':'legacy-primary','bankId':oldData.get('bankId',''),'bankName':oldData.get('bankName',''),
        'bankAccountName':oldData.get('bankAccountName',''),'bankAccountNumber':oldData.get('bankAccountNumber',''),
        'invoiceQrTemplate':oldData.get('invoiceQrTemplate','qr_only'),'autoReconcileByOrderCode':oldData.get('autoReconcileByOrderCode',true) != false,
        'sepayVirtualAccountNumber':oldData.get('sepayVirtualAccountNumber',oldData.get('sepayVaAccountNumber','')),
        'sepayUseVirtualAccount':oldData.get('sepayUseVirtualAccount',false) == true};
      let before = oldData.get('companyBankAccounts', oldData.get('bankAccountNumber','') != '' ? [legacy] : []);
      let after = newData.get('companyBankAccounts', []);
      let removed = before is list && after is list ? before.removeAll(after) : [];
      let added = before is list && after is list ? after.removeAll(before) : [];
      // The existing bank form changes one account per intent. The account
      // list itself is unbounded, and reordering/deleting unchanged rows works.
      return companyAction(context,'settings','manage_payment_qr')
        || (before is list && after is list && added.size() <= 1 && removed.size() <= 1
          && (added.size() == 0 || (added[0] is map
            && added[0].get('invoiceQrTemplate','qr_only') == (removed.size() == 0 ? 'qr_only' : removed[0].get('invoiceQrTemplate','qr_only')))));
    }

    function companyBasicSettingsAllowed(context, changed, oldData, newData) {
      return (!changed.hasAny(['name','displayName','companyPhone','companyAddress','logoUrl','logo']) || companyAction(context,'settings','edit_company_profile'))
        && (!changed.hasAny(['bankId','bankName','bankAccountName','bankAccountNumber','companyBankAccounts','primaryCompanyBankAccountId',
          'sepayVirtualAccountNumber','sepayVaAccountNumber','sepayVaNumber','sepayReceivingAccountNumber','bankVirtualAccountNumber','virtualBankAccountNumber',
          'vaAccountNumber','virtualAccountNumber','sepayUseVirtualAccount','autoReconcileByOrderCode']) || companyAction(context,'settings','manage_bank_accounts'))
        && (!changed.hasAny(['companyBankAccounts']) || companyBankQrAllowed(context,oldData,newData))
        && (!changed.hasAny(['invoiceQrTemplate','invoiceTemplateId']) || companyAction(context,'settings','manage_payment_qr'))
        && (!changed.hasAny(['customerLoyaltyEnabled','loyaltyEarnMode','loyaltyRevenuePercent','loyaltyEarnAmountPerPoint','loyaltyRedeemValuePerPoint','loyaltyEligibilityConditions']) || companyAction(context,'settings','manage_loyalty_settings'))
        && (!changed.hasAny(['customerCareReminderEnabled','customerCareInactiveDays','customerCareRules']) || companyAction(context,'settings','manage_customer_care_reminders'))
        && (!changed.hasAny(['warehouseOrderAutoCancelDays']) || companyAction(context,'settings','manage_warehouse_dispatch_settings') || companyAction(context,'settings','manage_order_request_auto_cancel'))
        && (!changed.hasAny(['floatingQuickActionEnabled']) || companyAction(context,'settings','manage_quick_action_defaults'));
    }

    function companyDomainSettingsAllowed(appId, context, changed) {
      return (!changed.hasAny(['warehouseStockResetAt','warehouseStockVisibilitySettings','dailyInventorySnapshots','processingInventorySnapshots'])
          || companyAction(context,'warehouse_import','edit_inventory_balance') || companyResetAction(context))
        && (!changed.hasAny(['warehouseQuantityUnits','warehouseQtyUnits']) || companyAction(context,'warehouse_import','create_warehouse_import') || companyAction(context,'warehouse_import','edit_warehouse_import'))
        && (!changed.hasAny(['productGroups']) || companyAction(context,'products','create_product') || companyAction(context,'products','edit_product') || companyAction(context,'warehouse_import','create_warehouse_import'))
        && (!changed.hasAny(['employeeDepartments','companyDepartments']) || companyAction(context,'employees','edit_employee'))
        && (!changed.hasAny(['salaryAdvancePercent','salaryAdvancePercentByDepartment']) || companyAction(context,'payroll','configure_salary_advance_limit'))
        && (!changed.hasAny(['employeeReviewCriteriaLabels']) || companyAction(context,'employee_reviews','manage_employee_review_criteria'))
        && (!changed.hasAny(companyPermissionKeys()) || canManageCompanyPermissions(appId))
        && (!changed.hasAny(companyWifiKeys()) || (canManageCompanyWifi() && companyAction(context,'settings','manage_attendance_wifi')));
    }

    function companyZaloFieldsAllowed(context, changed, oldData, newData) {
      let runtime = ['zaloDispatcherMachineId','zaloDispatcherMachineName','zaloDispatcherHeartbeatAt','updatedAt'];
      let healing = ['zaloDispatcherSendInvoicesEnabled','zaloDispatcherSendCampaignsEnabled','zaloDispatcherPaused','zaloDispatcherDisabled','updatedAt'];
      let wake = ['zaloDispatcherEnabled','zaloDispatcherDisabled','zaloDispatcherSendInvoicesEnabled','zaloDispatcherPaused',
        'zaloDispatcherDelayMinSec','zaloDispatcherDelayMaxSec','zaloDispatcherWakeAt','zaloDispatcherMachineId','zaloDispatcherMachineName','zaloDispatcherHeartbeatAt','updatedAt'];
      return companyAction(context,'settings','manage_gemini_api') || changed.hasOnly(runtime)
        || (changed.hasOnly(healing) && oldData.get('zaloDispatcherEnabled',false) == true
          && newData.get('zaloDispatcherSendInvoicesEnabled',true) == true && newData.get('zaloDispatcherSendCampaignsEnabled',true) == true
          && newData.get('zaloDispatcherPaused',false) == false && newData.get('zaloDispatcherDisabled',false) == false)
        || (changed.hasOnly(wake) && companyAction(context,'orders','edit_order_items')
          && newData.get('zaloDispatcherEnabled',false) == true && newData.get('zaloDispatcherDisabled',false) == false
          && newData.get('zaloDispatcherPaused',false) == false && newData.get('zaloDispatcherSendInvoicesEnabled',false) == true);
    }

    function companyAnyMutationAction(context) {
      let settings = context.actions.get('settings', {});
      let stock = context.actions.get('warehouse_import', {});
      let products = context.actions.get('products', {});
      let employees = context.actions.get('employees', {});
      let reviews = context.actions.get('employee_reviews', {});
      let payroll = context.actions.get('payroll', {});
      let roles = context.actions.get('role_permissions', {});
      let settingDefault = context.roleKey == 'accounting' && context.modules.get('settings',true) == true;
      let stockDefault = context.roleKey in ['accounting','warehouse'] && context.modules.get('warehouse_import',true) == true;
      let productDefault = context.roleKey == 'accounting' && context.modules.get('products',true) == true;
      return context.valid && (context.roleKey == 'owner'
        || settings.get('edit_company_profile',settingDefault) == true || settings.get('manage_bank_accounts',settingDefault) == true
        || settings.get('manage_payment_qr',settingDefault) == true || settings.get('manage_loyalty_settings',settingDefault) == true
        || settings.get('manage_customer_care_reminders',settingDefault) == true || settings.get('manage_warehouse_dispatch_settings',settingDefault) == true
        || settings.get('manage_order_request_auto_cancel',settingDefault) == true || settings.get('manage_quick_action_defaults',settingDefault) == true
        || settings.get('manage_employee_review_settings',false) == true || settings.get('manage_attendance_wifi',settingDefault) == true || settings.get('manage_gemini_api',settingDefault) == true
        || stock.get('create_warehouse_import',stockDefault) == true || stock.get('edit_warehouse_import',stockDefault) == true || stock.get('edit_inventory_balance',stockDefault) == true
        || products.get('create_product',productDefault) == true || products.get('edit_product',productDefault) == true
        || employees.get('edit_employee',context.roleKey == 'accounting' && context.modules.get('employees',true) == true) == true
        || reviews.get('manage_employee_review_criteria',false) == true || payroll.get('configure_salary_advance_limit',context.roleKey == 'accounting' && context.modules.get('payroll',true) == true) == true
        || roles.get('manage_role_permissions',false) == true || roles.get('manage_employee_permission_override',false) == true);
    }

    function companyFieldsAllowed(appId, context, changed, oldData, newData) {
      let ordinary = changed.difference(['id','companyId','updatedAt'].toSet());
      let zalo = changed.intersection(['zaloDispatcherEnabled','zaloDispatcherDisabled','zaloDispatcherMachineId','zaloDispatcherMachineName','zaloDispatcherHeartbeatAt',
        'zaloDispatcherWakeAt','zaloDispatcherDelayMinSec','zaloDispatcherDelayMaxSec','zaloDispatcherSendInvoicesEnabled','zaloDispatcherSendCampaignsEnabled',
        'zaloDispatcherPaused','zaloDispatcherMaxPerHour','zaloInboxBridgeEnabled','zaloInboxBridgeMachineId','zaloInboxBridgeMachineName','zaloInboxBridgeHeartbeatAt',
        'zaloInboxBridgeScanIntervalSec','zaloInboxBridgeClipboardEnabled','zaloInboxBridgeAutoProcessEnabled','enableAiAutoReply','aiAutoReplyDryRun',
        'aiAutoReplyStartTime','aiAutoReplyEndTime','aiAutoReplyMaxPerGroupPerHour','zaloSchedulerMode','zaloSchedulerDailyTime','zaloSchedulerDelayMinutes','zaloSchedulerEditHoldMinutes'].toSet());
      return context.valid && changed.hasOnly(companyMutationKeys())
        && (!changed.hasAny(['id']) || newData.get('id','') == request.auth.token.companyId)
        && (!changed.hasAny(['companyId']) || newData.get('companyId','') == request.auth.token.companyId)
        && (context.roleKey == 'owner' || (companyBasicSettingsAllowed(context,changed,oldData,newData)
          && companyDomainSettingsAllowed(appId,context,changed)
          && (zalo.size() == 0 || companyZaloFieldsAllowed(context,changed,oldData,newData))
          && (ordinary.size() > 0 || companyAnyMutationAction(context))));
    }

    function companyBoundedFieldsAllowed(appId, context, changed, oldData, newData) {
      let business = changed.difference(['id','companyId','updatedAt'].toSet());
      return context.valid
        && (!changed.hasAny(['id']) || newData.get('id','') == request.auth.token.companyId)
        && (!changed.hasAny(['companyId']) || newData.get('companyId','') == request.auth.token.companyId)
        && (context.roleKey == 'owner' ? changed.hasOnly(companyMutationKeys())
          : business.size() == 0 ? companyAnyMutationAction(context)
          : business.hasOnly(['name','displayName','companyPhone','companyAddress','logoUrl','logo']) ? companyAction(context,'settings','edit_company_profile')
          : business.hasOnly(['bankId','bankName','bankAccountName','bankAccountNumber','companyBankAccounts','primaryCompanyBankAccountId',
            'sepayVirtualAccountNumber','sepayVaAccountNumber','sepayVaNumber','sepayReceivingAccountNumber','bankVirtualAccountNumber','virtualBankAccountNumber',
            'vaAccountNumber','virtualAccountNumber','sepayUseVirtualAccount','autoReconcileByOrderCode','invoiceQrTemplate','invoiceTemplateId'])
            ? companyBasicSettingsAllowed(context,business,oldData,newData)
          : business.hasOnly(['customerLoyaltyEnabled','loyaltyEarnMode','loyaltyRevenuePercent','loyaltyEarnAmountPerPoint','loyaltyRedeemValuePerPoint',
            'loyaltyEligibilityConditions','customerCareReminderEnabled','customerCareInactiveDays','customerCareRules','warehouseOrderAutoCancelDays','floatingQuickActionEnabled'])
            ? companyBasicSettingsAllowed(context,business,oldData,newData)
          : business.hasOnly(['warehouseStockResetAt','warehouseStockVisibilitySettings','dailyInventorySnapshots','processingInventorySnapshots',
            'warehouseQuantityUnits','warehouseQtyUnits','productGroups','employeeDepartments','companyDepartments','salaryAdvancePercent',
            'salaryAdvancePercentByDepartment','employeeReviewCriteriaLabels','rolePermissions','rolePermissionActions','employeeRolePermissions','employeeRolePermissionActions'])
            ? companyDomainSettingsAllowed(appId,context,business)
          : business.hasOnly(['zaloDispatcherEnabled','zaloDispatcherDisabled','zaloDispatcherMachineId','zaloDispatcherMachineName','zaloDispatcherHeartbeatAt',
            'zaloDispatcherWakeAt','zaloDispatcherDelayMinSec','zaloDispatcherDelayMaxSec','zaloDispatcherSendInvoicesEnabled','zaloDispatcherSendCampaignsEnabled',
            'zaloDispatcherPaused','zaloDispatcherMaxPerHour','zaloInboxBridgeEnabled','zaloInboxBridgeMachineId','zaloInboxBridgeMachineName','zaloInboxBridgeHeartbeatAt',
            'zaloInboxBridgeScanIntervalSec','zaloInboxBridgeClipboardEnabled','zaloInboxBridgeAutoProcessEnabled','enableAiAutoReply','aiAutoReplyDryRun',
            'aiAutoReplyStartTime','aiAutoReplyEndTime','aiAutoReplyMaxPerGroupPerHour','zaloSchedulerMode','zaloSchedulerDailyTime','zaloSchedulerDelayMinutes','zaloSchedulerEditHoldMinutes'])
            ? companyZaloFieldsAllowed(context,changed,oldData,newData)
          : companyFieldsAllowed(appId,context,changed,oldData,newData));
    }

    function canWriteCompanyDocument(appId, companyId, oldData, newData) {
      let changed = newData.diff(oldData).affectedKeys();
      return isEmployeeIdentity() && companyId == request.auth.token.companyId
        && (changed.size() == 0
          || (changed.hasOnly(companyWifiKeys()) && !('appUserId' in request.auth.token) && canManageCompanyWifi())
          || (!changed.hasAny(companyEmployeeReviewKeys()) && companyBoundedFieldsAllowed(appId,companyMutationContext(appId),changed,oldData,newData)));
    }

    function companyCommandMetadata(data) {
      return data.companyId == request.auth.token.companyId && data.actorId == request.auth.token.appUserId
        && data.commandId is string && data.commandId.matches('^[A-Za-z0-9_-]{1,160}$')
        && data.fingerprint is string && data.fingerprint.matches('^[a-f0-9]{64}$')
        && data.mutationAt is string && data.mutationAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$');
    }

    function canCreateSettingsCommand(appId, docId, data) {
      let context = companyMutationContext(appId);
      let before = get(dispatchCompanyPath(appId)).data;
      let after = getAfter(dispatchCompanyPath(appId)).data;
      let changed = after.diff(before).affectedKeys();
      return isEmployeeIdentity() && data.keys().hasOnly(['companyId','actorId','commandId','fingerprint','mutationAt'])
        && companyCommandMetadata(data) && docId == data.companyId + '_' + data.actorId + '_' + data.commandId
        && companyAnyMutationAction(context)
        && (changed.hasAny(companyEmployeeReviewKeys()) ? changed.hasOnly(companyEmployeeReviewKeys())
            && companyAction(context,'settings','manage_employee_review_settings')
            && after.get('employeeReviewsEnabled',null) is bool
            && after.get('employeeReviewsUpdatedByEmpId','') == request.auth.token.appUserId
            && after.get('employeeReviewsUpdatedAt',null) == request.time
          : companyBoundedFieldsAllowed(appId,context,changed,before,after));
    }

    function companyDataCommandAction(context, kind) {
      return kind == 'restore' ? companyAction(context,'settings','restore_data') || companyAction(context,'settings','backup_restore_data')
        : kind == 'reset' && companyResetAction(context);
    }

    function validCompanyDataRoot(data, docId) {
      return data.keys().hasOnly(['companyId','actorId','kind','commandId','fingerprint','requestFingerprint','mutationAt','totalChunks','status'])
        && companyCommandMetadata(data) && docId == data.companyId + '_' + data.actorId + '_' + data.commandId
        && data.requestFingerprint is string && data.requestFingerprint.matches('^[a-f0-9]{64}$')
        && data.totalChunks is int && data.totalChunks >= 0 && data.kind in ['restore','reset']
        && data.status in ['preparing','prepared','complete'];
    }

    function companyDataPartAllowed(appId, docId, data, context) {
      let rootId = docId.replace('__part_[0-9]+$', '');
      let root = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/companyDataCommands/$(rootId)).data;
      return data.keys().hasOnly(['companyId','actorId','fingerprint','index','status','expected','operations'])
        && validCompanyDataRoot(root,rootId) && companyDataCommandAction(context,root.kind)
        && data.companyId == root.companyId && data.actorId == root.actorId && data.fingerprint == root.fingerprint
        && data.index is int && data.index >= 0 && data.index < root.totalChunks && docId == rootId + '__part_' + string(data.index)
        && data.expected is list && data.expected.size() <= 80 && data.status in ['prepared','done']
        && (root.kind == 'reset' ? data.operations is list && data.operations.size() == data.expected.size() : !('operations' in data));
    }

    function canWriteCompanyDataCommand(appId, docId, oldData, data, creating) {
      let context = companyMutationContext(appId);
      let part = 'index' in data;
      return isEmployeeIdentity() && context.valid
        && (part ? companyDataPartAllowed(appId,docId,data,context)
          : validCompanyDataRoot(data,docId) && companyDataCommandAction(context,data.kind))
        && (creating ? data.status == (part ? 'prepared' : 'preparing')
          : data.diff(oldData).affectedKeys().hasOnly(['status'])
            && (data.status == oldData.status || (part ? oldData.status == 'prepared' && data.status == 'done'
              : oldData.status == 'preparing' && data.status == 'prepared' || oldData.status == 'prepared' && data.status == 'complete')));
    }

    function dispatchActionEnabled(appId, actionId) {
      let employee = get(dispatchEmployeePath(appId)).data;
      let company = get(dispatchCompanyPath(appId)).data;
      let roleKey = request.auth.token.role in ['super_admin', 'owner', 'company_owner', 'business_owner']
        ? 'owner'
        : dispatchRoleKey(employee);
      let employeePermissions = company.get('employeeRolePermissions', {}).get(request.auth.token.appUserId, {});
      let employeeActions = company.get('employeeRolePermissionActions', {}).get(request.auth.token.appUserId, {});
      let hasEmployeeOverride = request.auth.token.appUserId in company.get('employeeRolePermissions', {});
      let permissionActions = hasEmployeeOverride
        ? employeeActions
        : company.get('rolePermissionActions', {}).get(roleKey, {});
      let moduleActions = permissionActions.get('warehouse_dispatch', {});
      let permissionSet = hasEmployeeOverride
        ? employeePermissions
        : company.get('rolePermissions', {}).get(roleKey, {});
      let moduleEnabled = permissionSet.get('warehouse_dispatch',
        roleKey in ['accounting', 'sales', 'warehouse']);
      return roleKey == 'owner'
        || (
          actionId in moduleActions
            ? moduleActions[actionId] == true
            : moduleEnabled
              && !(actionId == 'delete_dispatch_history_detail')
              && !(roleKey == 'driver' && actionId in [
                'create_warehouse_dispatch', 'create_dispatch_without_order_request',
                'edit_warehouse_dispatch', 'delete_warehouse_dispatch'
              ])
        );
    }

    function canCreateWarehouseDispatch(appId, docId, data) {
      return isEmployeeIdentity()
        && exists(dispatchEmployeePath(appId))
        && get(dispatchEmployeePath(appId)).data.companyId == request.auth.token.companyId
        && dispatchActionEnabled(appId, 'create_warehouse_dispatch')
        && docId == 'wd_' + request.auth.token.companyId + '_' + data.clientMutationId
        && data.clientMutationId is string
        && data.clientMutationId.size() > 0
        && data.clientMutationId.size() <= 160
        && data.companyId == request.auth.token.companyId;
    }

    function canUpdateWarehouseDispatch(appId, docId, oldData, newData) {
      return isEmployeeIdentity()
        && exists(dispatchEmployeePath(appId))
        && get(dispatchEmployeePath(appId)).data.companyId == request.auth.token.companyId
        && (
          (newData.get('isArchived', false) == true && oldData.get('isArchived', false) != true)
            ? (
              dispatchActionEnabled(appId, 'delete_warehouse_dispatch')
              || dispatchActionEnabled(appId, 'delete_dispatch_history_detail')
            )
            : (
              dispatchActionEnabled(appId, 'edit_warehouse_dispatch')
              || dispatchActionEnabled(appId, 'edit_dispatch_history_detail')
            )
        )
        && oldData.get('clientMutationId', '') == newData.get('clientMutationId', '')
        && newData.companyId == oldData.companyId
        && newData.companyId == request.auth.token.companyId;
    }

    function canDeleteWarehouseDispatch(appId) {
      return isEmployeeIdentity()
        && exists(dispatchEmployeePath(appId))
        && get(dispatchEmployeePath(appId)).data.companyId == request.auth.token.companyId
        && (
          dispatchActionEnabled(appId, 'delete_warehouse_dispatch')
          || dispatchActionEnabled(appId, 'delete_dispatch_history_detail')
        );
    }

    function employeeAttendanceSecurityKeys() {
      return ['role', 'position', 'primaryPosition', 'secondaryPositions', 'additionalPositions', 'departments', 'roleSalaryComponents', 'departmentSalaryComponents', 'salaryByDepartment', 'shiftStart', 'shiftEnd', 'graceMinutes', 'attendanceLocation', 'fixedAttendanceLocation', 'attendanceGpsLocation', 'attendanceLocationEnabled', 'fixedAttendanceLocationEnabled', 'attendanceGpsRequired', 'attendanceLocationRadiusMeters', 'attendanceGpsRadiusMeters', 'attendanceBiometricRequired'];
    }

    function isCustomerIdentity() {
      return hasIdentitySession()
        && request.auth.token.accountType == 'customer'
        && request.auth.token.customerId is string
        && request.auth.token.customerId.size() > 0
        && request.auth.token.appUserId is string
        && request.auth.token.appUserId.size() > 0;
    }

    function belongsToSignedInCompany(collectionId, docId, data) {
      return hasIdentitySession()
        && (
          (collectionId == 'companies' && docId == request.auth.token.companyId)
          || (
            collectionId != 'companies'
            && data.companyId is string
            && data.companyId == request.auth.token.companyId
          )
        );
    }

    function employeePath(appId, employeeId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(employeeId);
    }

    function customerPath(appId, customerId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/customers/$(customerId);
    }

    function hasNonEmptyStringField(data, fieldName) {
      return fieldName in data
        && data[fieldName] is string
        && data[fieldName].size() > 0;
    }

    function customerMessagingAssignment(data) {
      return hasNonEmptyStringField(data, 'empId') ? data.empId
        : hasNonEmptyStringField(data, 'assignedEmployeeId') ? data.assignedEmployeeId
        : hasNonEmptyStringField(data, 'salesEmpId') ? data.salesEmpId
        : hasNonEmptyStringField(data, 'managerEmpId') ? data.managerEmpId
        : hasNonEmptyStringField(data, 'employeeId') ? data.employeeId
        : hasNonEmptyStringField(data, 'responsibleEmployeeId') ? data.responsibleEmployeeId : '';
    }

    function customerMessagingAssignmentForCompany(appId, customerId) {
      let path = customerPath(appId, customerId);
      let customer = exists(path) ? get(path).data : null;
      return customer != null && customer.companyId == request.auth.token.companyId
        ? customerMessagingAssignment(customer) : null;
    }

    function customerMessageAssignmentStateMatches(appId, data) {
      let employeeId = customerMessagingAssignmentForCompany(appId, data.customerId);
      return employeeId != null && (employeeId != ''
        ? (data.assignmentState == 'assigned'
          && hasNonEmptyStringField(data, 'assignedEmployeeId')
          && data.assignedEmployeeId == employeeId)
        : (data.assignmentState == 'unclassified' && !('assignedEmployeeId' in data)));
    }

    // Resolve the current, authoritative catalog once per message write.
    // Read helpers below deliberately retain their existing query contract.
    function messagePermissionContext(appId) {
      let employee = get(dispatchEmployeePath(appId)).data;
      let company = get(dispatchCompanyPath(appId)).data;
      let roleKey = dispatchRoleKey(employee);
      let individual = request.auth.token.appUserId in company.get('employeeRolePermissions', {});
      let modules = individual ? company.get('employeeRolePermissions', {}).get(request.auth.token.appUserId, {})
        : company.get('rolePermissions', {}).get(roleKey, {});
      let actions = individual ? company.get('employeeRolePermissionActions', {}).get(request.auth.token.appUserId, {}).get('messages', {})
        : company.get('rolePermissionActions', {}).get(roleKey, {}).get('messages', {});
      return {'employee': employee, 'roleKey': roleKey, 'actions': actions,
        'valid': employee.companyId == request.auth.token.companyId && employee.get('isArchived', false) != true,
        'enabled': roleKey == 'owner' || modules.get('messages', true) == true};
    }

    function messageDefaultAction(roleKey, actionId) {
      // Actual App initializes the enabled module, then restricts these fine
      // defaults for staff. Explicit stored actions still override the module.
      return roleKey in ['owner','accounting']
        || (actionId in ['view_message_center','view_internal_messages','send_internal_messages',
          'view_own_notifications','send_image_attachment','send_contact_attachment',
          'send_location_attachment','call_from_message'])
        || (roleKey in ['sales','warehouse'] && actionId in ['send_order_attachment','send_order_request_attachment']);
    }

    function messageActionEnabled(context, actionId) {
      return context.valid
        && (context.roleKey == 'owner'
          || context.actions.get(actionId, context.enabled && messageDefaultAction(context.roleKey,actionId)) == true);
    }

    function messageAttachmentAction(type) {
      return type == 'image' ? 'send_image_attachment'
        : type in ['contact', 'customer'] ? 'send_contact_attachment'
        : type == 'location' ? 'send_location_attachment'
        : type == 'bank' ? 'send_bank_qr_attachment'
        : type == 'order' ? 'send_order_attachment'
        : type == 'order_request' ? 'send_order_request_attachment' : 'send_report_attachment';
    }

    function messageAttachmentsAllowed(context, data) {
      let type = data.get('attachmentType', '');
      return type in ['', 'image', 'contact', 'customer', 'location', 'bank', 'order', 'order_request', 'report']
        && (type == '' || messageActionEnabled(context, messageAttachmentAction(type)))
        && (data.get('attachmentImage', '') == ''
          || (data.attachmentImage is string && messageActionEnabled(context, 'send_image_attachment')));
    }

    function validMessageEmployee(appId, id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,200}$')
        && exists(employeePath(appId, id))
        && get(employeePath(appId, id)).data.companyId == request.auth.token.companyId
        && get(employeePath(appId, id)).data.get('isArchived', false) != true;
    }

    function messageDirectRecipientValid(appId, data) {
      let id = data.get('recipientEmpId', data.get('receiverEmpId', ''));
      return validMessageEmployee(appId, id) && id != request.auth.token.appUserId
        && data.get('receiverEmpId', id) == id && data.get('targetEmpId', id) == id && data.get('assignedEmployeeId', id) == id
        && data.get('conversationId', '') in ['internal-' + request.auth.token.appUserId + '-' + id, 'internal-' + id + '-' + request.auth.token.appUserId];
    }

    function messageGroupRecipientsValid(appId, data) {
      let ids = data.get('participantEmpIds', []);
      let serialized = ids is list ? ids.join(',') : '';
      // Group metadata grants no read access: company-isolated reads below are
      // unchanged. Parent validation checks every profile; avoid an arbitrary
      // member cap or a per-member lookup that exceeds Firestore's read budget.
      return ids is list && ids.size() >= 2 && ids.toSet().size() == ids.size()
        && serialized.matches('^[A-Za-z0-9_-]{1,200}(,[A-Za-z0-9_-]{1,200})+$')
        && ids == serialized.split(',')
        && request.auth.token.appUserId in ids
        && data.get('recipientEmpId', '') == '' && data.get('receiverEmpId', '') == ''
        && data.get('targetEmpId', '') == '' && data.get('assignedEmployeeId', '') == ''
        && hasNonEmptyStringField(data, 'conversationId')
        && data.get('groupId', data.conversationId) == data.conversationId;
    }

    function messagePlatformSupportValid(appId, data) {
      let customerId = data.get('customerId', '');
      let emptyRecipients = data.get('recipientEmpId', '') == '' && data.get('receiverEmpId', '') == ''
        && data.get('targetEmpId', '') == '' && data.get('assignedEmployeeId', '') == '';
      return emptyRecipients && (data.get('conversationId', '') == 'support-hd-manager'
        || (hasNonEmptyStringField(data, 'customerId') && data.get('conversationId', '') == 'support-customer-' + customerId
          && exists(customerPath(appId, customerId)) && get(customerPath(appId, customerId)).data.companyId == request.auth.token.companyId));
    }

    function employeeMessageCreateAllowed(appId, data) {
      let context = messagePermissionContext(appId);
      let type = data.get('conversationType', '');
      return type in ['internal', 'internal_group', 'support', 'customer_support']
        && data.get('senderType', '') == 'employee'
        && data.get('senderEmpId', '') == request.auth.token.appUserId
        && data.get('senderCustomerId', '') == ''
        && (!('senderName' in data) || !hasNonEmptyStringField(context.employee, 'name') || data.senderName == context.employee.name)
        && data.get('isArchived', false) == false
        && messageActionEnabled(context, type in ['support', 'customer_support'] ? 'send_support_messages' : 'send_internal_messages')
        && messageAttachmentsAllowed(context, data)
        && (type == 'internal' ? messageDirectRecipientValid(appId, data)
          : type == 'internal_group' ? messageGroupRecipientsValid(appId, data)
          : type == 'support' ? messagePlatformSupportValid(appId, data)
          : hasValidCustomerMessageRouting(appId, data)
            && (isMessagingManager(appId) || data.assignedEmployeeId == request.auth.token.appUserId));
    }

    function employeeMessageMetadataAllowed(appId, data) {
      let context = messagePermissionContext(appId);
      let support = data.get('conversationType', '') in ['support', 'customer_support'];
      return (messageActionEnabled(context, support ? 'view_support_messages' : 'view_internal_messages')
          || messageActionEnabled(context, support ? 'send_support_messages' : 'send_internal_messages'))
        && (context.roleKey == 'owner' || data.get('senderEmpId', '') == request.auth.token.appUserId
          || data.get('recipientEmpId', '') == request.auth.token.appUserId
          || request.auth.token.appUserId in data.get('participantEmpIds', []));
    }

    function isMessagingManager(appId) {
      return isEmployeeIdentity()
        && 'role' in request.auth.token
        && request.auth.token.role in [
          'super_admin',
          'owner',
          'company_owner',
          'business_owner',
          'admin',
          'manager',
          'accounting',
          'accountant'
        ];
    }

    function hasValidCustomerMessageRouting(appId, data) {
      return 'customerId' in data
        && data.customerId is string
        && data.customerId.size() > 0
        && 'conversationId' in data
        && data.conversationId is string
        && data.conversationId == 'customer_' + data.customerId
        && 'assignmentState' in data
        && data.assignmentState is string
        && customerMessageAssignmentStateMatches(appId, data);
    }

    function customerOwnsDocument(collectionId, docId, data) {
      return isCustomerIdentity()
        && (
          (collectionId == 'customers' && docId == request.auth.token.customerId)
          || ('customerId' in data && data.customerId == request.auth.token.customerId)
          || ('customer_id' in data && data.customer_id == request.auth.token.customerId)
          || ('createdByCustomerId' in data && data.createdByCustomerId == request.auth.token.customerId)
          || ('senderCustomerId' in data && data.senderCustomerId == request.auth.token.customerId)
        );
    }

    function customerOwnsInboxDocument(data) {
      return isCustomerIdentity()
        && data.companyId is string
        && data.companyId == request.auth.token.companyId
        && data.customerId is string
        && data.customerId == request.auth.token.customerId;
    }

    function canCustomerReadNotification(data) {
      return customerOwnsInboxDocument(data)
        && data.recipientType is string
        && data.recipientType == 'customer';
    }

    function canCustomerReadMessage(data) {
      return customerOwnsInboxDocument(data)
        && data.conversationType is string
        && data.conversationType == 'customer_support';
    }

    function canCustomerCreateMessage(appId, data) {
      return canCustomerReadMessage(data)
        && data.senderCustomerId is string
        && data.senderCustomerId == request.auth.token.customerId
        && data.senderType is string
        && data.senderType == 'customer'
        && data.source is string
        && data.source == 'customer_portal'
        && data.type is string
        && data.type in ['customer_to_employee', 'loyalty_point_withdraw_request']
        && hasValidCustomerMessageRouting(appId, data);
    }

    function canCustomerMarkNotificationRead(oldData, newData) {
      return canCustomerReadNotification(oldData)
        && canCustomerReadNotification(newData)
        && newData.companyId == oldData.companyId
        && newData.readStatus == 'read'
        && newData.readByCustomerId == request.auth.token.customerId
        && newData.diff(oldData).affectedKeys().hasOnly([
          'readStatus',
          'readAt',
          'readByCustomerId',
          'updatedAt'
        ]);
    }

    function canCustomerMarkMessageRead(oldData, newData) {
      return canCustomerReadMessage(oldData)
        && canCustomerReadMessage(newData)
        && newData.companyId == oldData.companyId
        && newData.customerReadById == request.auth.token.customerId
        && newData.diff(oldData).affectedKeys().hasOnly([
          'customerReadAt',
          'customerReadById',
          'updatedAt'
        ]);
    }

    function canCustomerReadDocument(collectionId, docId, data) {
      return isCustomerIdentity()
        && !(collectionId in [
          'companies',
          'products',
          'reward_catalog',
          'promotions',
          'customer_accounts',
          'customer_payment_intents',
          'customer_payment_intent_lookup',
          'customer_payment_intent_transactions'
        ])
        && (
          (collectionId == 'notifications' && canCustomerReadNotification(data))
          || (collectionId == 'messages' && canCustomerReadMessage(data))
          || (
            collectionId != 'notifications'
            && collectionId != 'messages'
            && customerOwnsDocument(collectionId, docId, data)
          )
        );
    }

    function isServerManagedCustomerPaymentCollection(collectionId) {
      return collectionId in [
        'customer_payment_intents',
        'customer_payment_intent_lookup',
        'customer_payment_intent_transactions'
      ];
    }

    function isCustomerWritableCollection(collectionId) {
      return collectionId in [
        'customers',
        'bankAccounts',
        'customer_cart',
        'orderRequests',
        'order_requests'
      ];
    }

    function canCustomerCreateDocument(appId, collectionId, docId, data) {
      return (collectionId == 'messages' && canCustomerCreateMessage(appId, data))
        || (
          collectionId != 'messages'
          && collectionId != 'notifications'
          && isCustomerWritableCollection(collectionId)
          && customerOwnsDocument(collectionId, docId, data)
        );
    }

    function canCustomerUpdateDocument(collectionId, docId, oldData, newData) {
      return (collectionId == 'notifications' && canCustomerMarkNotificationRead(oldData, newData))
        || (collectionId == 'messages' && canCustomerMarkMessageRead(oldData, newData))
        || (
          collectionId != 'messages'
          && collectionId != 'notifications'
          && isCustomerWritableCollection(collectionId)
          && customerOwnsDocument(collectionId, docId, oldData)
          && customerOwnsDocument(collectionId, docId, newData)
          && newData.companyId == oldData.companyId
          && (
            collectionId != 'customers'
            || newData.diff(oldData).affectedKeys().hasOnly([
              'name',
              'customerHonorific',
              'phone',
              'avatarUrl',
              'avatar',
              'address',
              'location',
              'locationUrl',
              'locationInput',
              'locationLat',
              'locationLng',
              'mapLocation',
              'locationUpdatedAt',
              'locationSource',
              'birthday',
              'dateOfBirth',
              'email',
              'zaloGroupLink',
              'zaloLink',
              'updatedAt'
            ])
          )
        );
    }

    function canCustomerDeleteDocument(collectionId, docId, data) {
      return collectionId in ['customer_cart', 'orderRequests', 'order_requests']
        && customerOwnsDocument(collectionId, docId, data);
    }

    function canEmployeeReadCustomerSupportMessage(appId, data) {
      return isMessagingManager(appId)
        || (
          isEmployeeIdentity()
          && data.assignmentState == 'assigned'
          && data.assignedEmployeeId == request.auth.token.appUserId
        );
    }

    function canEmployeeReadMessage(appId, data, listing) {
      let context = messagePermissionContext(appId);
      let internal = messageActionEnabled(context, 'view_internal_messages');
      let support = messageActionEnabled(context, 'view_support_messages');
      return isEmployeeIdentity() && context.valid
        && ((internal && support && isMessagingManager(appId))
          || (!listing && internal && (!('conversationType' in data)
            || (data.conversationType != 'customer_support' && data.conversationType != 'support')))
          || (internal && data.conversationType in ['internal','internal_group'])
          || (support && data.conversationType == 'support')
          || (support && data.conversationType == 'customer_support' && canEmployeeReadCustomerSupportMessage(appId,data)));
    }

    function canEmployeeCreateMessage(appId, data) {
      return isEmployeeIdentity()
        && exists(dispatchEmployeePath(appId)) && exists(dispatchCompanyPath(appId))
        && employeeMessageCreateAllowed(appId, data);
    }

    function canEmployeeUpdateMessage(appId, oldData, newData) {
      return isEmployeeIdentity()
        && exists(dispatchEmployeePath(appId)) && exists(dispatchCompanyPath(appId))
        && newData.diff(oldData).affectedKeys().hasOnly(['status', 'isArchived', 'archivedAt', 'archivedByEmpId',
          'employeeReadAt', 'employeeReadById', 'readAt', 'isRead', 'updatedAt'])
        && (!newData.diff(oldData).affectedKeys().hasAny(['employeeReadById']) || newData.employeeReadById == request.auth.token.appUserId)
        && (!newData.diff(oldData).affectedKeys().hasAny(['archivedByEmpId']) || newData.archivedByEmpId == request.auth.token.appUserId)
        && employeeMessageMetadataAllowed(appId, oldData);
    }

    function canEmployeeDeleteMessage(appId, data) {
      return isEmployeeIdentity()
        && exists(dispatchEmployeePath(appId)) && exists(dispatchCompanyPath(appId))
        && employeeMessageMetadataAllowed(appId, data);
    }

    // Messages cannot be payroll/warehouse/customer-payment documents. Keep
    // their auth, tenant, sender and action checks in this bounded branch rather
    // than evaluating unrelated collection policies before each attachment.
    function canCreateTenantMessage(appId, data) {
      return data.companyId == request.auth.token.companyId
        && (request.auth.token.accountType == 'employee'
          ? canEmployeeCreateMessage(appId, data) : canCustomerCreateMessage(appId, data));
    }

    function canUpdateTenantMessage(appId, oldData, newData) {
      return oldData.companyId == request.auth.token.companyId && newData.companyId == oldData.companyId
        && (request.auth.token.accountType == 'employee'
          ? canEmployeeUpdateMessage(appId, oldData, newData) : canCustomerMarkMessageRead(oldData, newData));
    }

    function canReadApplicationDocument(appId, collectionId, docId, data, listing) {
      return (isEmployeeIdentity()
        && collectionId != 'customer_accounts'
        && (collectionId != 'messages' || canEmployeeReadMessage(appId, data, listing)))
        || canCustomerReadDocument(collectionId, docId, data);
    }

    function payrollPeriodPath(appId, periodId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollPeriods/$(periodId);
    }

    function payrollSnapshotPath(appId, snapshotId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollSnapshots/$(snapshotId);
    }

    function payrollAdjustmentPath(appId, adjustmentId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollAdjustments/$(adjustmentId);
    }

    function payrollCarryoverPath(appId, carryoverId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollDebtCarryovers/$(carryoverId);
    }

    function payrollAutoLockPlanPath(appId, planId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/payrollAutoLockPlans/$(planId);
    }

    function isPayrollManager(appId) {
      return isEmployeeIdentity()
        && (
          (
            'role' in request.auth.token
            && request.auth.token.role in [
              'super_admin',
              'owner',
              'company_owner',
              'business_owner',
              'accounting',
              'accountant',
              'admin'
            ]
          )
          || (
            'appUserId' in request.auth.token
            && request.auth.token.appUserId is string
            && exists(employeePath(appId, request.auth.token.appUserId))
            && get(employeePath(appId, request.auth.token.appUserId)).data.companyId == request.auth.token.companyId
            && get(employeePath(appId, request.auth.token.appUserId)).data.position in [
              'Chủ doanh nghiệp',
              'Kế toán & nhân sự'
            ]
          )
        );
    }

    function isLockedPayrollStatus(status) {
      return status in ['LOCKED', 'ADJUSTED', 'AUTO_LOCKED', 'CLOSED', 'locked', 'adjusted', 'auto_locked', 'closed'];
    }

    function isImmutablePayrollCollection(collectionId) {
      return collectionId in [
        'payrollSnapshots',
        'payrollAdjustments',
        'automaticEvaluations',
        'automaticEvaluationDetails',
        'employeeEvaluationSummaries',
        'evaluationRewards',
        'evaluationAuditLogs'
      ];
    }

    function isProtectedPayrollCollection(collectionId) {
      return collectionId in [
        'payrollPeriods',
        'payrollSnapshots',
        'payrollAdjustments',
        'payrollDebtCarryovers',
        'payrollAutoLockPlans',
        'payrollAutoLockPlanSnapshots',
        'evaluationPeriods',
        'automaticEvaluations',
        'automaticEvaluationDetails',
        'employeeEvaluationSummaries',
        'evaluationRewards',
        'evaluationAuditLogs'
      ];
    }

    function isImmutablePayrollAudit(collectionId, data) {
      return collectionId == 'activityLogs'
        && data.type in ['payroll_adjustment', 'payroll_period_lock', 'payroll_debt_rollover'];
    }

    function isProtectedPayrollDocument(collectionId, data) {
      return isProtectedPayrollCollection(collectionId) || isImmutablePayrollAudit(collectionId, data);
    }

    function canReadPayrollDocument(collectionId, data) {
      return !isProtectedPayrollDocument(collectionId, data)
        || (
          hasCompanyClaim()
          && data.companyId is string
          && data.companyId == request.auth.token.companyId
        );
    }

    function hasCompletePayrollSnapshot(data) {
      return data.schemaVersion is int
        && data.schemaVersion >= 2
        && data.companyId is string
        && data.periodId is string
        && data.monthKey is string
        && data.employeeId is string
        && data.lockedAt is string
        && data.formulaVersion is string
        && data.formulaVersion.size() > 0
        && data.policyVersion is string
        && data.policyVersion.size() > 0
        && data.employee is map
        && data.salaryDetails is map
        && data.salaryDetails.netSalary is number
        && data.salaryDetails.endingDebt is number
        && data.policySnapshot is map
        && data.policySnapshot.values is map
        && data.policySnapshot.values.size() > 0
        && data.policySnapshot.version == data.policyVersion
        && data.policySnapshot.formulaVersion == data.formulaVersion
        && data.calculationSnapshot is map
        && data.calculationSnapshot.inputs is map
        && data.calculationSnapshot.additions is map
        && data.calculationSnapshot.deductions is map
        && data.calculationSnapshot.results is map
        && data.calculationSnapshot.results.grossSalary is number
        && data.calculationSnapshot.results.netSalary is number
        && data.calculationSnapshot.results.endingDebt is number;
    }

    function isVietnamPayrollMonthEnd(monthKey) {
      let localTime = request.time + duration.value(7, 'h');
      let localMonth = localTime.month();
      let localMonthKey = string(localTime.year()) + '-' + (localMonth < 10 ? '0' : '') + string(localMonth);
      return monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && (monthKey < localMonthKey || (monthKey == localMonthKey
          && (localTime + duration.value(1, 'd')).month() != localMonth));
    }

    function isValidLockedPayrollPeriodCreate(appId, docId) {
      return isPayrollManager(appId)
        && request.resource.data.id == docId
        && request.resource.data.status == 'LOCKED'
        && request.resource.data.companyId == request.auth.token.companyId
        && request.resource.data.monthKey is string
        && isVietnamPayrollMonthEnd(request.resource.data.monthKey)
        && request.resource.data.lockedAt is string
        && request.resource.data.closedAtServer == request.time
        && request.resource.data.snapshotIds is list
        && request.resource.data.snapshotIds.size() > 0
        && request.resource.data.employeeCount == request.resource.data.snapshotIds.size()
        && request.resource.data.debtCarryoverIds is list;
    }

    function isValidPayrollSnapshotCreate(appId, docId) {
      let data = request.resource.data;
      let period = getAfter(payrollPeriodPath(appId, data.periodId)).data;
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && hasCompletePayrollSnapshot(data)
        && data.salaryDetails.get('commissionCalculation', {}).get('ready', true) == true
        && existsAfter(payrollPeriodPath(appId, data.periodId))
        && period.companyId == data.companyId
        && period.monthKey == data.monthKey
        && isLockedPayrollStatus(period.status)
        && period.snapshotIds is list
        && docId in period.snapshotIds;
    }

    function isValidPayrollCarryoverCreate(appId, docId) {
      let data = request.resource.data;
      let period = getAfter(payrollPeriodPath(appId, data.sourcePeriodId)).data;
      let snapshot = getAfter(payrollSnapshotPath(appId, data.sourceSnapshotId)).data;
      let adjustmentId = 'adjustedByPayrollAdjustmentId' in data
        ? data.adjustedByPayrollAdjustmentId
        : '';
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.employeeId is string
        && data.amount is number
        && data.amount >= 0
        && existsAfter(payrollPeriodPath(appId, data.sourcePeriodId))
        && existsAfter(payrollSnapshotPath(appId, data.sourceSnapshotId))
        && period.companyId == data.companyId
        && isLockedPayrollStatus(period.status)
        && period.debtCarryoverIds is list
        && docId in period.debtCarryoverIds
        && snapshot.companyId == data.companyId
        && snapshot.periodId == data.sourcePeriodId
        && snapshot.employeeId == data.employeeId
        && (
          (
            adjustmentId == ''
            && data.amount > 0
            && data.amount == snapshot.salaryDetails.endingDebt
          )
          || (
            adjustmentId is string
            && adjustmentId.size() > 0
            && existsAfter(payrollAdjustmentPath(appId, adjustmentId))
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.companyId == data.companyId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.periodId == data.sourcePeriodId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.snapshotId == data.sourceSnapshotId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.employeeId == data.employeeId
            && getAfter(payrollAdjustmentPath(appId, adjustmentId)).data.afterSalaryDetails.endingDebt == data.amount
            && period.lastAdjustmentId == adjustmentId
          )
        );
    }

    function isValidPayrollAdjustmentCreate(appId, docId) {
      let data = request.resource.data;
      let period = getAfter(payrollPeriodPath(appId, data.periodId)).data;
      let priorPeriod = get(payrollPeriodPath(appId, data.periodId)).data;
      let snapshot = get(payrollSnapshotPath(appId, data.snapshotId)).data;
      let previousAdjustmentId = data.previousAdjustmentId;
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.status == 'ADJUSTED'
        && data.reason is string
        && data.reason.size() > 0
        && data.beforeSalaryDetails is map
        && data.afterSalaryDetails is map
        && data.beforeSalaryDetails.netSalary is number
        && data.beforeSalaryDetails.endingDebt is number
        && data.afterSalaryDetails.netSalary is number
        && data.afterSalaryDetails.netSalary >= 0
        && data.afterSalaryDetails.endingDebt is number
        && data.afterSalaryDetails.endingDebt >= 0
        && data.differences is map
        && data.differences.netSalary == data.afterSalaryDetails.netSalary - data.beforeSalaryDetails.netSalary
        && data.differences.endingDebt == data.afterSalaryDetails.endingDebt - data.beforeSalaryDetails.endingDebt
        && data.sequence is int
        && data.sequence >= 1
        && previousAdjustmentId is string
        && exists(payrollSnapshotPath(appId, data.snapshotId))
        && existsAfter(payrollPeriodPath(appId, data.periodId))
        && snapshot.companyId == data.companyId
        && snapshot.periodId == data.periodId
        && snapshot.employeeId == data.employeeId
        && snapshot.monthKey == data.monthKey
        && period.status == 'ADJUSTED'
        && period.lastAdjustmentId == docId
        && period.latestAdjustmentBySnapshot is map
        && period.latestAdjustmentBySnapshot[data.snapshotId] == docId
        && (
          (
            previousAdjustmentId == ''
            && data.sequence == 1
            && data.beforeSalaryDetails == snapshot.salaryDetails
            && (
              !('latestAdjustmentBySnapshot' in priorPeriod)
              || !(data.snapshotId in priorPeriod.latestAdjustmentBySnapshot)
            )
          )
          || (
            previousAdjustmentId.size() > 0
            && exists(payrollAdjustmentPath(appId, previousAdjustmentId))
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.companyId == data.companyId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.periodId == data.periodId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.snapshotId == data.snapshotId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.employeeId == data.employeeId
            && get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.afterSalaryDetails == data.beforeSalaryDetails
            && data.sequence == get(payrollAdjustmentPath(appId, previousAdjustmentId)).data.sequence + 1
            && priorPeriod.latestAdjustmentBySnapshot[data.snapshotId] == previousAdjustmentId
          )
        );
    }

    function hasValidPayrollAutoLockPlanPayload(docId, data) {
      return data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.status in ['OPEN', 'READY']
        && data.rulesVersion == 'PAYROLL_FREEZE_RULES_V2'
        && data.periodId is string
        && data.monthKey is string
        && data.autoLockAt is string
        && data.closingSchedule is map
        && data.closingSchedule.mode == 'MONTH_END'
        && data.closingSchedule.timeZone == 'Asia/Ho_Chi_Minh'
        && data.closingSchedule.time == '23:59:59'
        && data.stagedSnapshotIds is list
        && data.stagedSnapshotIds.size() > 0
        && data.expectedEmployeeIds is list
        && data.expectedEmployeeIds.size() == data.stagedSnapshotIds.size()
        && data.snapshotCount == data.stagedSnapshotIds.size()
        && (
          data.status == 'READY'
          || (
            data.period is map
            && data.period.status == 'OPEN'
            && !('lockedAt' in data.period)
          )
        );
    }

    function isValidPayrollAutoLockPlanCreate(appId, docId) {
      return isPayrollManager(appId)
        && hasValidPayrollAutoLockPlanPayload(docId, request.resource.data);
    }

    function isValidPayrollAutoLockPlanUpdate(appId, docId) {
      return isPayrollManager(appId)
        && resource.data.status in ['OPEN', 'READY']
        && resource.data.rulesVersion == 'PAYROLL_FREEZE_RULES_V2'
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.monthKey == resource.data.monthKey
        && hasValidPayrollAutoLockPlanPayload(docId, request.resource.data);
    }

    function isValidPayrollAutoLockSnapshotWrite(appId, docId) {
      let data = request.resource.data;
      let plan = getAfter(payrollAutoLockPlanPath(appId, data.planId)).data;
      return isPayrollManager(appId)
        && data.id == docId
        && data.companyId == request.auth.token.companyId
        && data.snapshotId is string
        && data.employeeId is string
        && data.periodId is string
        && data.monthKey is string
        && existsAfter(payrollAutoLockPlanPath(appId, data.planId))
        && plan.companyId == data.companyId
        && plan.periodId == data.periodId
        && plan.monthKey == data.monthKey
        && plan.status in ['OPEN', 'READY']
        && plan.rulesVersion == 'PAYROLL_FREEZE_RULES_V2'
        && plan.stagedSnapshotIds is list
        && docId in plan.stagedSnapshotIds
        && (
          (
            plan.status == 'OPEN'
            && data.status == 'STAGED'
            && !('lockedAt' in data)
            && !('lockedByEmployeeId' in data)
          )
          || (
            plan.status == 'READY'
            && hasCompletePayrollSnapshot(data)
          )
        );
    }

    function isValidPayrollAuditCreate(appId) {
      let data = request.resource.data;
      return isPayrollManager(appId)
        && (
          (
            data.type == 'payroll_period_lock'
            && data.periodId is string
            && existsAfter(payrollPeriodPath(appId, data.periodId))
            && isLockedPayrollStatus(getAfter(payrollPeriodPath(appId, data.periodId)).data.status)
          )
          || (
            data.type == 'payroll_debt_rollover'
            && data.carryoverId is string
            && existsAfter(payrollCarryoverPath(appId, data.carryoverId))
          )
          || (
            data.type == 'payroll_adjustment'
            && data.adjustmentId is string
            && existsAfter(payrollAdjustmentPath(appId, data.adjustmentId))
          )
        );
    }

    function isAllowedLockedPayrollPeriodAdjustment(appId, docId) {
      let adjustmentId = request.resource.data.lastAdjustmentId;
      let adjustment = getAfter(payrollAdjustmentPath(appId, adjustmentId)).data;
      let priorAdjustmentCount = 'adjustmentCount' in resource.data
        ? resource.data.adjustmentCount
        : 0;
      return isPayrollManager(appId)
        && isLockedPayrollStatus(resource.data.status)
        && request.resource.data.status == 'ADJUSTED'
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.monthKey == resource.data.monthKey
        && request.resource.data.lockedAt == resource.data.lockedAt
        && request.resource.data.snapshotIds == resource.data.snapshotIds
        && adjustmentId is string
        && adjustmentId.size() > 0
        && existsAfter(payrollAdjustmentPath(appId, adjustmentId))
        && adjustment.companyId == resource.data.companyId
        && adjustment.periodId == docId
        && request.resource.data.latestAdjustmentBySnapshot is map
        && request.resource.data.latestAdjustmentBySnapshot[adjustment.snapshotId] == adjustmentId
        && request.resource.data.adjustmentCount == priorAdjustmentCount + 1
        && request.resource.data.debtTransferCount == request.resource.data.debtCarryoverIds.size()
        && request.resource.data.totals.totalSalary == resource.data.totals.totalSalary + adjustment.differences.netSalary
        && request.resource.data.totals.totalEndingDebt == resource.data.totals.totalEndingDebt + adjustment.differences.endingDebt
        && request.resource.data.totalEndingDebt == request.resource.data.totals.totalEndingDebt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'totals',
          'totalEndingDebt',
          'debtCarryoverIds',
          'debtTransferCount',
          'adjustmentCount',
          'latestAdjustmentBySnapshot',
          'lastAdjustmentId',
          'lastAdjustedAt',
          'lastAdjustedByEmployeeId',
          'updatedAt'
        ]);
    }

    function isAllowedPayrollDebtCarryoverAdjustment(appId, docId) {
      let adjustmentId = request.resource.data.adjustedByPayrollAdjustmentId;
      let adjustment = getAfter(payrollAdjustmentPath(appId, adjustmentId)).data;
      let period = getAfter(payrollPeriodPath(appId, resource.data.sourcePeriodId)).data;
      return isPayrollManager(appId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.sourcePeriodId == resource.data.sourcePeriodId
        && request.resource.data.sourceSnapshotId == resource.data.sourceSnapshotId
        && request.resource.data.sourceMonthKey == resource.data.sourceMonthKey
        && request.resource.data.targetMonthKey == resource.data.targetMonthKey
        && adjustmentId is string
        && adjustmentId.size() > 0
        && existsAfter(payrollAdjustmentPath(appId, adjustmentId))
        && existsAfter(payrollPeriodPath(appId, resource.data.sourcePeriodId))
        && adjustment.companyId == resource.data.companyId
        && adjustment.periodId == resource.data.sourcePeriodId
        && adjustment.snapshotId == resource.data.sourceSnapshotId
        && adjustment.employeeId == resource.data.employeeId
        && request.resource.data.amount == adjustment.afterSalaryDetails.endingDebt
        && (
          (
            request.resource.data.amount == 0
            && request.resource.data.status == 'cleared_by_adjustment'
            && request.resource.data.isArchived == true
          )
          || (
            request.resource.data.amount > 0
            && request.resource.data.status == 'adjusted_carry_over'
            && request.resource.data.isArchived == false
          )
        )
        && period.lastAdjustmentId == adjustmentId
        && period.debtCarryoverIds is list
        && docId in period.debtCarryoverIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount',
          'status',
          'isArchived',
          'adjustedByPayrollAdjustmentId',
          'updatedAt'
        ]);
    }

    // Salary cash-out vouchers are written only by the verified server
    // transaction. Clients may read them under the existing company/RBAC scope,
    // but cannot forge, archive or change the linked money movement directly.
    function isServerManagedSalaryVoucher(collectionId, data) {
      return collectionId == 'expenses' && (
        data.get('sourceType', '') == 'payroll_settlement'
        || data.keys().hasAny(['payrollSnapshotId', 'payrollPaymentId', 'payrollSettlement'])
      );
    }

    // Paused endpoints retain server ownership of their authoritative journal.
    // Plain legacy warehouse documents continue to use existing client CRUD.
    function isServerOwnedJournalCollection(collectionId) {
      return collectionId in ['inventoryBalances','inventoryLedger','inventoryOperations',
        'orderReturns','orderReturnStates','inventoryReturnStates','inventoryDamagedReturns',
        'paymentCorrections','paymentCorrectionStates','refundReceipts'];
    }

    function isInventoryManagedWarehouseDocument(collectionId, data) {
      return collectionId in ['warehouseImports','warehouseDispatches','warehouseStockCounts']
        && data.keys().hasAny(['inventoryOperationId','inventoryOperationVersion','inventoryMovements',
          'inventoryCommittedAt','inventoryCommittedByEmployeeId','ledgerId','stockLedgerId',
          'inventoryLedgerId','inventoryTransactionId','ledgerTransactionId']);
    }

    function isServerOwnedJournalAudit(collectionId, docId, data) {
      return collectionId == 'activityLogs' && (docId.matches('^audit_(iop_|ort_).*')
        || data.get('id','').matches('^audit_(iop_|ort_).*')
        || data.get('action','') in ['INVENTORY_COMMITTED','ORDER_RETURN_COMMITTED']);
    }

    function canUpdateInventoryJournalLink(collectionId, oldData, newData) {
      return collectionId == 'warehouseDispatches'
        && oldData.companyId == newData.companyId
        && newData.diff(oldData).affectedKeys().hasOnly(['linkedOrderId','linkedOrderCreatedAt','updatedAt']);
    }

    function canUpdateWarehouseJournalDocument(appId, collectionId, docId, oldData, newData) {
      // These collections are not customer, payroll, review or cashflow docs.
      // Keep their existing employee/tenant/dispatch policy bounded, including
      // failed setDoc creates which Firestore also evaluates as updates.
      return isEmployeeIdentity()
        && oldData.companyId == request.auth.token.companyId
        && newData.companyId == oldData.companyId
        && ((!isInventoryManagedWarehouseDocument(collectionId,oldData)
          && !isInventoryManagedWarehouseDocument(collectionId,newData))
          || canUpdateInventoryJournalLink(collectionId,oldData,newData))
        && (collectionId != 'warehouseDispatches' || canUpdateWarehouseDispatch(appId,docId,oldData,newData));
    }

    function validOrderCreationMarker(docId, oldData, newData, creating) {
      let marker = newData.get('orderCreationCommand', null);
      let before = oldData.get('orderCreationCommand', null);
      return creating ? (marker == null || (marker is map
        && marker.keys().hasOnly(['id','fingerprint']) && marker.keys().hasAll(['id','fingerprint'])
        && marker.id is string && marker.id.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,159}$')
        && marker.fingerprint is string && marker.fingerprint.size() > 0
        && newData.get('clientMutationId','') == marker.id
        && docId.matches('^o_[a-z0-9]+_[a-z0-9]+_' + marker.id + '$')))
        : (marker == before && (before == null || newData.get('clientMutationId','') == oldData.get('clientMutationId','')));
    }

    function canChangeOrderArchive(appId, oldData, newData) {
      return oldData.get('isArchived',false) == newData.get('isArchived',false)
        || (newData.get('isArchived',false) is bool && companyAction(companyMutationContext(appId),'orders','delete_order'));
    }

    match /artifacts/{appId}/public/data/{collectionId}/{docId} {
      allow get: if hasIdentitySession()
        && (
          resource == null
            ? (!isProtectedPayrollCollection(collectionId) || isPayrollManager(appId))
            : (
              belongsToSignedInCompany(collectionId, docId, resource.data)
              && canReadApplicationDocument(appId, collectionId, docId, resource.data, false)
              && canReadPayrollDocument(collectionId, resource.data)
            )
        );

      allow list: if hasIdentitySession()
        && belongsToSignedInCompany(collectionId, docId, resource.data)
        && canReadApplicationDocument(appId, collectionId, docId, resource.data, true)
        && canReadPayrollDocument(collectionId, resource.data);

      allow create: if hasIdentitySession()
        && (collectionId != 'orders' || validOrderCreationMarker(docId,{},request.resource.data,true))
        && !isServerManagedCustomerPaymentCollection(collectionId)
        && (collectionId == 'companySettingsCommands' ? canCreateSettingsCommand(appId,docId,request.resource.data)
          : collectionId == 'companyDataCommands' ? canWriteCompanyDataCommand(appId,docId,{},request.resource.data,true)
          : collectionId == 'companies' ? canWriteCompanyDocument(appId,docId,{},request.resource.data)
          : collectionId == 'messages' ? canCreateTenantMessage(appId, request.resource.data)
          : collectionId == 'employees' ? canWriteEmployeeDocument(appId, {}, request.resource.data, true) : (
          !isServerOwnedJournalCollection(collectionId)
        && !isInventoryManagedWarehouseDocument(collectionId,request.resource.data)
        && !isServerOwnedJournalAudit(collectionId,docId,request.resource.data)
        && employeeReviewWritesEnabled(appId, collectionId)
        && !isServerManagedSalaryVoucher(collectionId, request.resource.data)
        && (collectionId != 'attendance' || isPayrollManager(appId))
        && (collectionId != 'companies' || !request.resource.data.keys().hasAny(companyWifiKeys()) || canManageCompanyWifi())
        && (collectionId != 'companies' || !request.resource.data.keys().hasAny(companyPermissionKeys()) || canManageCompanyPermissions(appId))
        && (collectionId != 'companies' || !request.resource.data.keys().hasAny(companyEmployeeReviewKeys()) || canChangeCompanyEmployeeReviews(appId))
        && belongsToSignedInCompany(collectionId, docId, request.resource.data)
        && (collectionId != 'warehouseDispatches' || canCreateWarehouseDispatch(appId, docId, request.resource.data))
        && (
          (
            isEmployeeIdentity()
            && collectionId != 'customer_accounts'
            && (collectionId != 'messages' || canEmployeeCreateMessage(appId, request.resource.data))
          )
          || canCustomerCreateDocument(appId, collectionId, docId, request.resource.data)
        )
        && (
          (collectionId == 'payrollPeriods' && isValidLockedPayrollPeriodCreate(appId, docId))
          || (collectionId == 'payrollSnapshots' && isValidPayrollSnapshotCreate(appId, docId))
          || (collectionId == 'payrollAdjustments' && isValidPayrollAdjustmentCreate(appId, docId))
          || (collectionId == 'payrollDebtCarryovers' && isValidPayrollCarryoverCreate(appId, docId))
          || (collectionId == 'payrollAutoLockPlans' && isValidPayrollAutoLockPlanCreate(appId, docId))
          || (collectionId == 'payrollAutoLockPlanSnapshots' && isValidPayrollAutoLockSnapshotWrite(appId, docId))
          || (collectionId == 'activityLogs' && isImmutablePayrollAudit(collectionId, request.resource.data) && isValidPayrollAuditCreate(appId))
          || (!isProtectedPayrollCollection(collectionId) && !isImmutablePayrollAudit(collectionId, request.resource.data))
        )));

      allow update: if hasIdentitySession()
        && resource != null
        && (collectionId != 'orders' || validOrderCreationMarker(docId,resource.data,request.resource.data,false))
        && (collectionId != 'orders' || canChangeOrderArchive(appId,resource.data,request.resource.data))
        && !isServerManagedCustomerPaymentCollection(collectionId)
        && (collectionId == 'companySettingsCommands' ? false
          : collectionId == 'companyDataCommands' ? canWriteCompanyDataCommand(appId,docId,resource.data,request.resource.data,false)
          : collectionId == 'messages' ? canUpdateTenantMessage(appId, resource.data, request.resource.data)
          : collectionId == 'companies' && request.resource.data.diff(resource.data).affectedKeys().hasAny(companyEmployeeReviewKeys())
          ? canWriteCompanyEmployeeReviewSettings(appId, docId)
          : collectionId == 'companies' ? canWriteCompanyDocument(appId,docId,resource.data,request.resource.data)
          : collectionId == 'employees' ? canWriteEmployeeDocument(appId, resource.data, request.resource.data, false)
          : collectionId in ['warehouseImports','warehouseDispatches','warehouseStockCounts']
            ? canUpdateWarehouseJournalDocument(appId,collectionId,docId,resource.data,request.resource.data) : (
          !isServerOwnedJournalCollection(collectionId)
        && ((!isInventoryManagedWarehouseDocument(collectionId,resource.data)
          && !isInventoryManagedWarehouseDocument(collectionId,request.resource.data))
          || canUpdateInventoryJournalLink(collectionId,resource.data,request.resource.data))
        && !isServerOwnedJournalAudit(collectionId,docId,resource.data)
        && !isServerOwnedJournalAudit(collectionId,docId,request.resource.data)
        && employeeReviewWritesEnabled(appId, collectionId)
        && !isServerManagedSalaryVoucher(collectionId, resource.data)
        && !isServerManagedSalaryVoucher(collectionId, request.resource.data)
        && (collectionId != 'customers'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(customerProductKeys())
          || canManageCustomerProductConfig(appId, resource.data))
        && (collectionId != 'attendance' || isPayrollManager(appId))
        && (collectionId != 'companies' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(companyWifiKeys()) || canManageCompanyWifi())
        && (collectionId != 'companies' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(companyPermissionKeys()) || canManageCompanyPermissions(appId))
        && (collectionId != 'companies' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(companyEmployeeReviewKeys()) || canChangeCompanyEmployeeReviews(appId))
        && belongsToSignedInCompany(collectionId, docId, resource.data)
        && belongsToSignedInCompany(collectionId, docId, request.resource.data)
        && (collectionId != 'warehouseDispatches' || canUpdateWarehouseDispatch(appId, docId, resource.data, request.resource.data))
        && (
          (
            isEmployeeIdentity()
            && collectionId != 'customer_accounts'
            && (collectionId != 'messages' || canEmployeeUpdateMessage(appId, resource.data, request.resource.data))
          )
          || canCustomerUpdateDocument(collectionId, docId, resource.data, request.resource.data)
        )
        && !isImmutablePayrollCollection(collectionId)
        && !isImmutablePayrollAudit(collectionId, resource.data)
        && (
          !isProtectedPayrollCollection(collectionId)
          || (
            collectionId == 'payrollPeriods'
            && isLockedPayrollStatus(resource.data.status)
            && isAllowedLockedPayrollPeriodAdjustment(appId, docId)
          )
          || (
            collectionId == 'payrollDebtCarryovers'
            && isAllowedPayrollDebtCarryoverAdjustment(appId, docId)
          )
          || (
            collectionId == 'payrollAutoLockPlans'
            && isValidPayrollAutoLockPlanUpdate(appId, docId)
          )
          || (
            collectionId == 'payrollAutoLockPlanSnapshots'
            && isValidPayrollAutoLockSnapshotWrite(appId, docId)
          )
        )));

      allow delete: if hasIdentitySession()
        && !(collectionId in ['companies','companySettingsCommands','companyDataCommands'])
        && !isServerOwnedJournalCollection(collectionId)
        && !isInventoryManagedWarehouseDocument(collectionId,resource.data)
        && !isServerOwnedJournalAudit(collectionId,docId,resource.data)
        && employeeReviewWritesEnabled(appId, collectionId)
        && !isServerManagedSalaryVoucher(collectionId, resource.data)
        && !isServerManagedCustomerPaymentCollection(collectionId)
        && (collectionId != 'attendance' || isPayrollManager(appId))
        && (collectionId != 'employees' || isPayrollManager(appId))
        && (collectionId != 'companies' || canManageCompanyWifi())
        && (collectionId != 'warehouseDispatches' || canDeleteWarehouseDispatch(appId))
        && belongsToSignedInCompany(collectionId, docId, resource.data)
        && (
          (
            isEmployeeIdentity()
            && collectionId != 'customer_accounts'
            && (collectionId != 'messages' || canEmployeeDeleteMessage(appId, resource.data))
          )
          || canCustomerDeleteDocument(collectionId, docId, resource.data)
        )
        && !isImmutablePayrollCollection(collectionId)
        && !isImmutablePayrollAudit(collectionId, resource.data)
        && (
          !isProtectedPayrollCollection(collectionId)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
