PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# App ID dang dung trong Firestore path: artifacts/{appId}/public/data/...
HD_MANAGER_APP_ID=hd-manager-production

# Public URL sau khi deploy Firebase Hosting.
HD_MANAGER_PUBLIC_URL=https://hd-manager-c5839.web.app

# Tuy chon. Neu bo trong, Functions tu tao tu HD_MANAGER_PUBLIC_URL.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Bat buoc khi dung SePay webhook tren production.
# Cau hinh cung gia tri nay o SePay de ngan request gia mao.
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_SECRET=

# Bat buoc de doi soat giao dich chu dong khi webhook tre hoac that lac.
# Dat bien nay o Functions/Secret Manager, khong bao gio dung VITE_SEPAY_API_TOKEN.
SEPAY_API_TOKEN=
# Tuy chon: UUID tai khoan ngan hang tren SePay de chi tai giao dich cua tai khoan nay.
SEPAY_BANK_ACCOUNT_ID=
# Tuy chon: App IDs can doi soat, phan cach bang dau phay.
HD_MANAGER_SEPAY_APP_IDS=
# Mac dinh 24 gio, toi da 7 ngay. Tac vu dinh ky chay moi 5 phut va doi soat lai co chu y.
SEPAY_RECONCILIATION_LOOKBACK_MINUTES=1440
# Toi da 100 giao dich/trang, gioi han so trang de ton trong rate limit SePay.
SEPAY_RECONCILIATION_MAX_PAGES=10

# Server-side only. Never expose this value through a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Danh sach origin duoc phep goi Functions, phan cach bang dau phay.
# Vi du: https://hd-manager-c5839.web.app,capacitor://localhost
HD_MANAGER_ALLOWED_ORIGINS=
