{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/utils/payrollAdjustment.js",
    "src/utils/payrollDebtCarryover.js",
    "src/utils/payrollPeriodLock.js",
    "src/utils/payrollPolicyHistory.js",
    "src/utils/payrollSnapshotIntegrity.js"
  ]
}
